<mxfile host="Electron" agent="HomeLodge-Doc" pages="1">
  <diagram id="wf-auth-02-desk" name="Login (Desktop)">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Web Browser Window -->
        <mxCell id="browser_frame" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;arcSize=2;" value="" vertex="1">
          <mxGeometry x="10" y="10" width="980" height="680" as="geometry" />
        </mxCell>
        <mxCell id="browser_top" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#cccccc;" value="" vertex="1">
          <mxGeometry x="10" y="10" width="980" height="40" as="geometry" />
        </mxCell>
        <mxCell id="browser_dots" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontColor=#aaaaaa;" value="● ● ●" vertex="1">
          <mxGeometry x="20" y="15" width="80" height="30" as="geometry" />
        </mxCell>
        <mxCell id="browser_url" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;fontColor=#666666;align=left;spacingLeft=10;" value="🔒 https://homelodge.example.com/login" vertex="1">
          <mxGeometry x="120" y="15" width="600" height="30" as="geometry" />
        </mxCell>

        <!-- Two Column Layout Container -->
        <mxCell id="main_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;shadow=1;arcSize=4;" value="" vertex="1">
          <mxGeometry x="150" y="90" width="700" height="520" as="geometry" />
        </mxCell>

        <!-- Left Column: Branding / Marketing -->
        <mxCell id="left_bg" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4A90D9;strokeColor=none;" value="" vertex="1">
          <mxGeometry x="150" y="90" width="300" height="520" as="geometry" />
        </mxCell>
        <mxCell id="logo" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=32;fontStyle=1;fontColor=#ffffff;" value="HomeLodge" vertex="1">
          <mxGeometry x="175" y="240" width="250" height="50" as="geometry" />
        </mxCell>
        <mxCell id="tagline" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontColor=#e0e0e0;" value="Welcome back!&lt;br&gt;Sign in to manage your bookings." vertex="1">
          <mxGeometry x="150" y="300" width="300" height="40" as="geometry" />
        </mxCell>

        <!-- Right Column: Login Form -->
        <mxCell id="form_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#333333;" value="Sign In" vertex="1">
          <mxGeometry x="490" y="130" width="300" height="40" as="geometry" />
        </mxCell>

        <!-- Email -->
        <mxCell id="lbl_email" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#444444;" value="Email Address" vertex="1">
          <mxGeometry x="490" y="190" width="100" height="20" as="geometry" />
        </mxCell>
        <mxCell id="inp_email" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;align=left;spacingLeft=10;fontSize=12;fontColor=#333333;" value="john@example.com" vertex="1">
          <mxGeometry x="490" y="210" width="320" height="40" as="geometry" />
        </mxCell>

        <!-- Password -->
        <mxCell id="lbl_pwd" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#444444;" value="Password" vertex="1">
          <mxGeometry x="490" y="270" width="100" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lnk_forgot" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=right;fontSize=11;fontColor=#4A90D9;fontStyle=4;" value="Forgot Password?" vertex="1">
          <mxGeometry x="700" y="270" width="110" height="20" as="geometry" />
        </mxCell>
        <mxCell id="inp_pwd" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;align=left;spacingLeft=10;fontSize=12;fontColor=#333333;" value="••••••••" vertex="1">
          <mxGeometry x="490" y="290" width="320" height="40" as="geometry" />
        </mxCell>

        <!-- Error Msg Placeholder (Hidden by default, shown for context) -->
        <mxCell id="err_msg" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#a94442;fontStyle=1;" value="⚠️ Invalid credentials" vertex="1">
          <mxGeometry x="490" y="335" width="320" height="20" as="geometry" />
        </mxCell>

        <!-- Submit Button -->
        <mxCell id="btn_submit" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4A90D9;strokeColor=none;fontColor=#ffffff;fontSize=14;fontStyle=1;" value="Sign In" vertex="1">
          <mxGeometry x="490" y="365" width="320" height="45" as="geometry" />
        </mxCell>

        <!-- OR Divider -->
        <mxCell id="div_line_l" parent="1" style="line;strokeColor=#cccccc;html=1;" value="" vertex="1">
          <mxGeometry x="490" y="435" width="130" height="1" as="geometry" />
        </mxCell>
        <mxCell id="div_txt" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#999999;" value="OR" vertex="1">
          <mxGeometry x="620" y="425" width="60" height="20" as="geometry" />
        </mxCell>
        <mxCell id="div_line_r" parent="1" style="line;strokeColor=#cccccc;html=1;" value="" vertex="1">
          <mxGeometry x="680" y="435" width="130" height="1" as="geometry" />
        </mxCell>

        <!-- Login with Google -->
        <mxCell id="btn_google" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontColor=#333333;fontSize=14;fontStyle=1;" value="G&amp;nbsp;&amp;nbsp;Sign in with Google" vertex="1">
          <mxGeometry x="490" y="465" width="320" height="45" as="geometry" />
        </mxCell>

        <!-- Register Link -->
        <mxCell id="lnk_reg" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="Don't have an account? &lt;font color='#4A90D9'&gt;&lt;b&gt;Sign up&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry x="490" y="540" width="320" height="30" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
