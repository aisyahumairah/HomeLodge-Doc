        <mxCell id="inp_new" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;align=left;spacingLeft=10;fontSize=11;fontColor=#999999;" value="Enter new password" vertex="1">
          <mxGeometry x="240" y="290" width="400" height="36" as="geometry" />
