        <!-- Tabs -->
        <mxCell id="tab_container" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;" value="" vertex="1">
          <mxGeometry x="240" y="90" width="510" height="40" as="geometry" />
        </mxCell>
        <mxCell id="tab1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontColor=#666666;fontSize=12;align=center;" value="Personal Details" vertex="1">
          <mxGeometry x="240" y="95" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="tab2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontColor=#4A90D9;fontSize=12;fontStyle=1;align=center;" value="Change Password" vertex="1">
          <mxGeometry x="370" y="95" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="tab2_line" parent="1" style="line;strokeColor=#4A90D9;strokeWidth=2;html=1;" value="" vertex="1">
          <mxGeometry x="370" y="123" width="120" height="2" as="geometry" />
        </mxCell>
        <mxCell id="tab_line" parent="1" style="line;strokeColor=#cccccc;html=1;" value="" vertex="1">
          <mxGeometry x="240" y="123" width="510" height="1" as="geometry" />
        </mxCell>

        <!-- Form Area -->
        <mxCell id="form_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#333333;" value="Update Password" vertex="1">
          <mxGeometry x="240" y="150" width="200" height="30" as="geometry" />
        </mxCell>

        <!-- Current Password -->
        <mxCell id="lbl_curr" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#444444;fontStyle=1;" value="Current Password" vertex="1">
          <mxGeometry x="240" y="190" width="150" height="20" as="geometry" />
