          <mxGeometry x="240" y="360" width="400" height="36" as="geometry" />
        </mxCell>

        <!-- Policy Note -->
        <mxCell id="pwd_note" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#999999;" value="Password must be at least 8 characters long and contain numbers and letters." vertex="1">
          <mxGeometry x="240" y="400" width="400" height="20" as="geometry" />
        </mxCell>

        <!-- Update btn -->
        <mxCell id="btn_update" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4A90D9;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;" value="Update Password" vertex="1">
