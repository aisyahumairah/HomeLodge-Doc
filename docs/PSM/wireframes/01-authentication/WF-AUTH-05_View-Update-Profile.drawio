        <mxCell id="inp_curr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;align=left;spacingLeft=10;fontSize=11;fontColor=#333333;" value="••••••••" vertex="1">
          <mxGeometry x="240" y="210" width="400" height="36" as="geometry" />
