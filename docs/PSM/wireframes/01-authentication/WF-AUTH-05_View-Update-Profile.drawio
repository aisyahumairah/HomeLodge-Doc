        <!-- Page title -->
        <mxCell id="content_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#333333;" value="My Profile" vertex="1">
          <mxGeometry x="240" y="50" width="200" height="30" as="geometry" />
