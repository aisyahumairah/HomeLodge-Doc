        <mxCell id="nav3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=none;align=left;spacingLeft=15;fontSize=11;fontColor=#333333;fontStyle=1;" value="Profile" vertex="1">
          <mxGeometry x="10" y="180" width="200" height="40" as="geometry" />
