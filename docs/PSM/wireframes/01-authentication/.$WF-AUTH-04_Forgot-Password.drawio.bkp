<mxfile host="Electron" agent="HomeLodge-Doc" pages="3">
  <!-- Page 1: Forgot Password Form -->
  <diagram id="wf-auth-04-desk" name="Forgot Password (Desktop)">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Web Browser Window -->
        <mxCell id="browser_frame" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;arcSize=2;" value="" vertex="1">
          <mxGeometry x="10" y="10" width="980" height="680" as="geometry" />
        </mxCell>
        <mxCell id="browser_top" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#cccccc;" value="" vertex="1">
          <mxGeometry x="10" y="10" width="980" height="40" as="geometry" />
        </mxCell>
        <mxCell id="browser_dots" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontColor=#aaaaaa;" value="● ● ●" vertex="1">
          <mxGeometry x="20" y="15" width="80" height="30" as="geometry" />
        </mxCell>
        <mxCell id="browser_url" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;fontColor=#666666;align=left;spacingLeft=10;" value="🔒 https://homelodge.example.com/password/reset" vertex="1">
          <mxGeometry x="120" y="15" width="600" height="30" as="geometry" />
        </mxCell>

        <!-- Centered Card Layout Container -->
        <mxCell id="main_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;shadow=1;arcSize=4;" value="" vertex="1">
          <mxGeometry x="290" y="150" width="420" height="360" as="geometry" />
        </mxCell>

        <mxCell id="logo" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#4A90D9;" value="HomeLodge" vertex="1">
          <mxGeometry x="350" y="180" width="300" height="30" as="geometry" />
        </mxCell>

        <!-- Form Title -->
        <mxCell id="form_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#333333;" value="Forgot Password?" vertex="1">
          <mxGeometry x="350" y="220" width="300" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="desc" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="Enter your email address and we will send you&lt;br&gt;a link to reset your password." vertex="1">
          <mxGeometry x="330" y="260" width="340" height="40" as="geometry" />
        </mxCell>

        <!-- Email -->
        <mxCell id="lbl_email" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#444444;" value="Email Address" vertex="1">
          <mxGeometry x="340" y="320" width="100" height="20" as="geometry" />
        </mxCell>
        <mxCell id="inp_email" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;align=left;spacingLeft=10;fontSize=12;fontColor=#999999;" value="e.g. john@example.com" vertex="1">
          <mxGeometry x="340" y="340" width="320" height="40" as="geometry" />
        </mxCell>

        <!-- Submit Button -->
        <mxCell id="btn_submit" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4A90D9;strokeColor=none;fontColor=#ffffff;fontSize=14;fontStyle=1;" value="Send Reset Link" vertex="1">
          <mxGeometry x="340" y="400" width="320" height="45" as="geometry" />
        </mxCell>

        <!-- Back Link -->
        <mxCell id="lnk_back" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="&lt;font color='#4A90D9'&gt;Back to Login&lt;/font&gt;" vertex="1">
          <mxGeometry x="340" y="460" width="320" height="30" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- Page 2: Check Your Email -->
  <diagram id="wf-auth-04-check" name="Check Email (Desktop)">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="2" pageScale="1" pageWidth="1000" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Web Browser Window -->
        <mxCell id="browser_frame" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;arcSize=2;" value="" vertex="1">
          <mxGeometry x="10" y="10" width="980" height="680" as="geometry" />
        </mxCell>
        <mxCell id="browser_top" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#cccccc;" value="" vertex="1">
          <mxGeometry x="10" y="10" width="980" height="40" as="geometry" />
        </mxCell>
        <mxCell id="browser_dots" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontColor=#aaaaaa;" value="● ● ●" vertex="1">
          <mxGeometry x="20" y="15" width="80" height="30" as="geometry" />
        </mxCell>
        <mxCell id="browser_url" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;fontColor=#666666;align=left;spacingLeft=10;" value="🔒 https://homelodge.example.com/password/sent" vertex="1">
          <mxGeometry x="120" y="15" width="600" height="30" as="geometry" />
        </mxCell>

        <!-- Centered Card Layout Container -->
        <mxCell id="main_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;shadow=1;arcSize=4;" value="" vertex="1">
          <mxGeometry x="290" y="150" width="420" height="320" as="geometry" />
        </mxCell>

        <mxCell id="logo" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#4A90D9;" value="HomeLodge" vertex="1">
          <mxGeometry x="350" y="180" width="300" height="30" as="geometry" />
        </mxCell>

        <!-- Form Title -->
        <mxCell id="form_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#333333;" value="Check Your Email" vertex="1">
          <mxGeometry x="350" y="240" width="300" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="desc" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="We've sent a password reset link to:&lt;br&gt;&lt;b&gt;john@example.com&lt;/b&gt;&lt;br&gt;&lt;br&gt;Please check your inbox (and spam folder) and click the link to create a new password." vertex="1">
          <mxGeometry x="320" y="280" width="360" height="60" as="geometry" />
        </mxCell>

        <!-- Back Link -->
        <mxCell id="lnk_back" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="Didn't receive the email? &lt;font color='#4A90D9'&gt;Click here to resend&lt;/font&gt;" vertex="1">
          <mxGeometry x="340" y="370" width="320" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lnk_back2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="&lt;font color='#4A90D9'&gt;&lt;b&gt;Back to Login&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry x="340" y="410" width="320" height="30" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- Page 3: Set New Password -->
  <diagram id="wf-auth-04-set" name="Set New Password (Desktop)">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="3" pageScale="1" pageWidth="1000" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Web Browser Window -->
        <mxCell id="browser_frame" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;arcSize=2;" value="" vertex="1">
          <mxGeometry x="10" y="10" width="980" height="680" as="geometry" />
        </mxCell>
        <mxCell id="browser_top" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#cccccc;" value="" vertex="1">
          <mxGeometry x="10" y="10" width="980" height="40" as="geometry" />
        </mxCell>
        <mxCell id="browser_dots" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontColor=#aaaaaa;" value="● ● ●" vertex="1">
          <mxGeometry x="20" y="15" width="80" height="30" as="geometry" />
        </mxCell>
        <mxCell id="browser_url" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=12;fontColor=#666666;align=left;spacingLeft=10;" value="🔒 https://homelodge.example.com/password/set-new?token=abc123xyz" vertex="1">
          <mxGeometry x="120" y="15" width="600" height="30" as="geometry" />
        </mxCell>

        <!-- Centered Card Layout Container -->
        <mxCell id="main_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;shadow=1;arcSize=4;" value="" vertex="1">
          <mxGeometry x="290" y="150" width="420" height="380" as="geometry" />
        </mxCell>

        <mxCell id="logo" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#4A90D9;" value="HomeLodge" vertex="1">
          <mxGeometry x="350" y="180" width="300" height="30" as="geometry" />
        </mxCell>

        <!-- Form Title -->
        <mxCell id="form_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#333333;" value="Set New Password" vertex="1">
          <mxGeometry x="350" y="220" width="300" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="desc" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="Please create a strong new password for your account." vertex="1">
          <mxGeometry x="330" y="250" width="340" height="30" as="geometry" />
        </mxCell>

        <!-- New Password -->
        <mxCell id="lbl_new" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#444444;" value="New Password" vertex="1">
          <mxGeometry x="340" y="290" width="100" height="20" as="geometry" />
        </mxCell>
        <mxCell id="inp_new" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;align=left;spacingLeft=10;fontSize=12;fontColor=#999999;" value="Enter new password" vertex="1">
          <mxGeometry x="340" y="310" width="320" height="40" as="geometry" />
        </mxCell>

        <!-- Confirm Password -->
        <mxCell id="lbl_conf" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#444444;" value="Confirm Password" vertex="1">
          <mxGeometry x="340" y="360" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="inp_conf" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;align=left;spacingLeft=10;fontSize=12;fontColor=#999999;" value="Re-enter new password" vertex="1">
          <mxGeometry x="340" y="380" width="320" height="40" as="geometry" />
        </mxCell>

        <!-- Submit Button -->
        <mxCell id="btn_submit" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4A90D9;strokeColor=none;fontColor=#ffffff;fontSize=14;fontStyle=1;" value="Save New Password" vertex="1">
          <mxGeometry x="340" y="450" width="320" height="45" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
