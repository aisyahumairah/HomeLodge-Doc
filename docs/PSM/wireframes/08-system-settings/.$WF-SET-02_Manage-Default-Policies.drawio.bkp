<mxfile host="Electron" agent="HomeLodge-Doc" pages="2">
  <!-- Page 1: List Default Policies -->
  <diagram id="wf-set-02-list" name="Manage Default Policies">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="frame" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;arcSize=4;" value="" vertex="1">
          <mxGeometry x="10" y="10" width="780" height="580" as="geometry" />
        </mxCell>
        <!-- Sidebar Navigation -->
        <mxCell id="sidebar" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;" value="" vertex="1">
          <mxGeometry x="10" y="35" width="200" height="555" as="geometry" />
        </mxCell>
        <mxCell id="nav_settings" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=none;align=left;spacingLeft=15;fontSize=11;fontColor=#333333;fontStyle=1;" value="System Settings" vertex="1">
          <mxGeometry x="10" y="180" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="nav_policies" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=none;align=left;spacingLeft=25;fontSize=10;fontColor=#333333;" value="Default House Rules" vertex="1">
          <mxGeometry x="10" y="220" width="200" height="30" as="geometry" />
        </mxCell>

        <!-- Header -->
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#333333;" value="Default House Rules &amp; Policies" vertex="1">
          <mxGeometry x="240" y="50" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="btn_create" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5cb85c;strokeColor=none;fontColor=#ffffff;fontSize=11;fontStyle=1;" value="+ Add Policy" vertex="1">
          <mxGeometry x="640" y="50" width="110" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="desc" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;" value="These rules will be automatically copied to newly created Homestay Units. Changes made here will not retroactively affect existing units." vertex="1">
          <mxGeometry x="240" y="90" width="510" height="30" as="geometry" />
        </mxCell>

        <!-- Table -->
        <mxCell id="tbl_bg" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" value="" vertex="1">
          <mxGeometry x="240" y="130" width="510" height="250" as="geometry" />
        </mxCell>
        <mxCell id="tbl_head" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#cccccc;" value="" vertex="1">
          <mxGeometry x="240" y="130" width="510" height="30" as="geometry" />
        </mxCell>
        <mxCell id="th1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#333333;" value="Order" vertex="1"><mxGeometry x="250" y="135" width="40" height="20" as="geometry" /></mxCell>
        <mxCell id="th2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#333333;" value="Policy Text" vertex="1"><mxGeometry x="300" y="135" width="200" height="20" as="geometry" /></mxCell>
        <mxCell id="th3" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#333333;" value="Actions" vertex="1"><mxGeometry x="650" y="135" width="90" height="20" as="geometry" /></mxCell>
        
        <!-- Row 1 -->
        <mxCell id="td1_1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" value="1" vertex="1"><mxGeometry x="250" y="170" width="40" height="30" as="geometry" /></mxCell>
        <mxCell id="td1_2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" value="No smoking inside the premises." vertex="1"><mxGeometry x="300" y="170" width="300" height="30" as="geometry" /></mxCell>
        <mxCell id="td1_3" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontColor=#4A90D9;fontStyle=4;" value="Edit | Delete" vertex="1"><mxGeometry x="650" y="170" width="90" height="30" as="geometry" /></mxCell>
        <mxCell id="row1_line" parent="1" style="line;strokeColor=#eeeeee;html=1;" value="" vertex="1"><mxGeometry x="240" y="205" width="510" height="1" as="geometry" /></mxCell>
        
        <!-- Row 2 -->
        <mxCell id="td2_1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" value="2" vertex="1"><mxGeometry x="250" y="210" width="40" height="30" as="geometry" /></mxCell>
        <mxCell id="td2_2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" value="No pets allowed." vertex="1"><mxGeometry x="300" y="210" width="300" height="30" as="geometry" /></mxCell>
        <mxCell id="td2_3" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontColor=#4A90D9;fontStyle=4;" value="Edit | Delete" vertex="1"><mxGeometry x="650" y="210" width="90" height="30" as="geometry" /></mxCell>
        <mxCell id="row2_line" parent="1" style="line;strokeColor=#eeeeee;html=1;" value="" vertex="1"><mxGeometry x="240" y="245" width="510" height="1" as="geometry" /></mxCell>

        <!-- Row 3 -->
        <mxCell id="td3_1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" value="3" vertex="1"><mxGeometry x="250" y="250" width="40" height="30" as="geometry" /></mxCell>
        <mxCell id="td3_2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;" value="Quiet hours between 10:00 PM and 7:00 AM." vertex="1"><mxGeometry x="300" y="250" width="300" height="30" as="geometry" /></mxCell>
        <mxCell id="td3_3" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontColor=#4A90D9;fontStyle=4;" value="Edit | Delete" vertex="1"><mxGeometry x="650" y="250" width="90" height="30" as="geometry" /></mxCell>
        <mxCell id="row3_line" parent="1" style="line;strokeColor=#eeeeee;html=1;" value="" vertex="1"><mxGeometry x="240" y="285" width="510" height="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  
  <!-- Page 2: Edit Form Modal -->
  <diagram id="wf-set-02-edit" name="Add/Edit Policy Modal">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="2" pageScale="1" pageWidth="800" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="frame" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;arcSize=4;" value="" vertex="1">
          <mxGeometry x="10" y="10" width="780" height="580" as="geometry" />
        </mxCell>
        <!-- Background Blur Simulation -->
        <mxCell id="bg_blur" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcfcfc;strokeColor=#cccccc;opacity=60;" value="" vertex="1">
          <mxGeometry x="10" y="10" width="780" height="580" as="geometry" />
        </mxCell>
        <!-- Modal Overlay -->
        <mxCell id="modal" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;shadow=1;arcSize=4;" value="" vertex="1">
          <mxGeometry x="200" y="150" width="400" height="280" as="geometry" />
        </mxCell>
        <mxCell id="m_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#333333;" value="Edit Default Policy" vertex="1">
          <mxGeometry x="220" y="160" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m_line" parent="1" style="line;strokeColor=#cccccc;html=1;" value="" vertex="1">
          <mxGeometry x="200" y="195" width="400" height="1" as="geometry" />
        </mxCell>
        
        <mxCell id="lbl_order" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#444444;" value="Display Order" vertex="1">
          <mxGeometry x="220" y="210" width="100" height="20" as="geometry" />
        </mxCell>
        <mxCell id="inp_order" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;align=left;spacingLeft=10;fontSize=11;fontColor=#333333;" value="1" vertex="1">
          <mxGeometry x="220" y="230" width="80" height="30" as="geometry" />
        </mxCell>

        <mxCell id="lbl_text" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#444444;" value="Policy Text" vertex="1">
          <mxGeometry x="220" y="270" width="100" height="20" as="geometry" />
        </mxCell>
        <mxCell id="inp_text" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=11;fontColor=#333333;" value="No smoking inside the premises." vertex="1">
          <mxGeometry x="220" y="290" width="360" height="60" as="geometry" />
        </mxCell>

        <mxCell id="btn_cancel" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#cccccc;fontColor=#333333;fontSize=11;" value="Cancel" vertex="1">
          <mxGeometry x="380" y="380" width="90" height="30" as="geometry" />
        </mxCell>
        <mxCell id="btn_save" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4A90D9;strokeColor=none;fontColor=#ffffff;fontSize=11;fontStyle=1;" value="Save Policy" vertex="1">
          <mxGeometry x="480" y="380" width="100" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
