<mxfile host="Electron" agent="HomeLodge-Doc" pages="3">
  <!-- Booking Form (New Page Added) -->
  <diagram id="wf-bk-02-form" name="Submit Booking — Form">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="frame" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;arcSize=4;" value="" vertex="1">
          <mxGeometry x="10" y="10" width="780" height="780" as="geometry" />
        </mxCell>
        <!-- Header -->
        <mxCell id="header" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;" value="" vertex="1">
          <mxGeometry x="10" y="10" width="780" height="60" as="geometry" />
        </mxCell>
        <mxCell id="logo" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#333333;" value="HomeLodge" vertex="1">
          <mxGeometry x="30" y="25" width="140" height="30" as="geometry" />
        </mxCell>
        <!-- Page Title -->
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#333333;" value="Complete Your Booking" vertex="1">
          <mxGeometry x="40" y="100" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="back" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#4A90D9;fontStyle=4;" value="&lt; Back to Calendar" vertex="1">
          <mxGeometry x="40" y="130" width="150" height="20" as="geometry" />
        </mxCell>
        <!-- Left Column: Form -->
        <mxCell id="form_title1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#333333;" value="Guest Details" vertex="1">
          <mxGeometry x="40" y="180" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lbl_adults" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#444444;" value="Adults" vertex="1">
          <mxGeometry x="40" y="210" width="100" height="20" as="geometry" />
        </mxCell>
        <mxCell id="inp_adults" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;align=left;spacingLeft=10;fontSize=11;fontColor=#333333;" value="2 ▼" vertex="1">
          <mxGeometry x="40" y="230" width="180" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lbl_children" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#444444;" value="Children" vertex="1">
          <mxGeometry x="250" y="210" width="100" height="20" as="geometry" />
        </mxCell>
        <mxCell id="inp_children" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;align=left;spacingLeft=10;fontSize=11;fontColor=#333333;" value="0 ▼" vertex="1">
          <mxGeometry x="250" y="230" width="180" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lbl_req" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#444444;" value="Special Requests (Optional)" vertex="1">
          <mxGeometry x="40" y="280" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="inp_req" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=11;fontColor=#999999;" value="Let the host know if you have any special needs..." vertex="1">
          <mxGeometry x="40" y="300" width="390" height="80" as="geometry" />
        </mxCell>
        <mxCell id="form_title2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#333333;" value="House Rules &amp; Agreement" vertex="1">
          <mxGeometry x="40" y="420" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="rules_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#cccccc;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=11;fontColor=#666666;" value="• Check-in time: 15:00&lt;br&gt;• Check-out time: 12:00&lt;br&gt;• No smoking inside the premises&lt;br&gt;• No pets allowed" vertex="1">
          <mxGeometry x="40" y="450" width="390" height="80" as="geometry" />
        </mxCell>
        <mxCell id="chk_agree" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;" value="" vertex="1">
          <mxGeometry x="40" y="550" width="15" height="15" as="geometry" />
        </mxCell>
        <mxCell id="lbl_agree" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#333333;" value="I agree to the house rules and the cancellation policy." vertex="1">
          <mxGeometry x="65" y="547" width="350" height="20" as="geometry" />
        </mxCell>
        <mxCell id="btn_submit_real" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5cb85c;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;arcSize=10;" value="Confirm &amp; Submit Booking" vertex="1">
          <mxGeometry x="40" y="600" width="390" height="40" as="geometry" />
        </mxCell>
        <mxCell id="info_sub" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=9;fontColor=#999999;" value="You won't be charged yet. Payment is required in the next step." vertex="1">
          <mxGeometry x="40" y="650" width="390" height="20" as="geometry" />
        </mxCell>
        <!-- Right Column: Booking Summary Card -->
        <mxCell id="sum_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;arcSize=4;" value="" vertex="1">
          <mxGeometry x="480" y="180" width="260" height="320" as="geometry" />
        </mxCell>
        <mxCell id="sum_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#333333;" value="Booking Summary" vertex="1">
          <mxGeometry x="500" y="195" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="sum_unit" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="Sunset Villa" vertex="1">
          <mxGeometry x="500" y="220" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="sum_div1" parent="1" style="line;strokeColor=#eeeeee;html=1;" value="" vertex="1">
          <mxGeometry x="500" y="245" width="220" height="1" as="geometry" />
        </mxCell>
        <mxCell id="sum_dates" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#444444;" value="Check-in:&lt;br&gt;Check-out:" vertex="1">
          <mxGeometry x="500" y="260" width="100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sum_dates_val" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#333333;" value="11 Jun 2026&lt;br&gt;14 Jun 2026" vertex="1">
          <mxGeometry x="600" y="260" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sum_div2" parent="1" style="line;strokeColor=#eeeeee;html=1;" value="" vertex="1">
          <mxGeometry x="500" y="305" width="220" height="1" as="geometry" />
        </mxCell>
        <mxCell id="sum_rate" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#444444;" value="RM 250 x 3 nights" vertex="1">
          <mxGeometry x="500" y="320" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="sum_rate_val" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=11;fontColor=#333333;" value="RM 750.00" vertex="1">
          <mxGeometry x="620" y="320" width="100" height="20" as="geometry" />
        </mxCell>
        <mxCell id="sum_dep" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#444444;" value="Refundable Deposit" vertex="1">
          <mxGeometry x="500" y="340" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="sum_dep_val" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=11;fontColor=#333333;" value="RM 100.00" vertex="1">
          <mxGeometry x="620" y="340" width="100" height="20" as="geometry" />
        </mxCell>
        <mxCell id="sum_div3" parent="1" style="line;strokeColor=#cccccc;html=1;" value="" vertex="1">
          <mxGeometry x="500" y="375" width="220" height="1" as="geometry" />
        </mxCell>
        <mxCell id="sum_total" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#333333;" value="Total Charge" vertex="1">
          <mxGeometry x="500" y="390" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sum_total_val" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#4A90D9;" value="RM 850.00" vertex="1">
          <mxGeometry x="620" y="390" width="100" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="wf-bk-02-success" name="Submit Booking — Success">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="2" pageScale="1" pageWidth="800" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="frame" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;arcSize=4;" value="" vertex="1">
          <mxGeometry x="10" y="10" width="780" height="580" as="geometry" />
        </mxCell>
        <!-- Success State -->
        <mxCell id="icon" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dff0d8;strokeColor=#d6e9c6;fontSize=36;fontColor=#3c763d;" value="✓" vertex="1">
          <mxGeometry x="350" y="150" width="100" height="100" as="geometry" />
        </mxCell>
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#333333;" value="Booking Reserved!" vertex="1">
          <mxGeometry x="250" y="270" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="msg" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=12;fontColor=#666666;" value="Your dates have been successfully held.&lt;br&gt;To confirm your booking, please complete your payment.&lt;br&gt;&lt;br&gt;&lt;b&gt;You have 24 hours to make payment before the reservation expires.&lt;/b&gt;" vertex="1">
          <mxGeometry x="200" y="310" width="400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="btn_pay" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4A90D9;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;" value="Proceed to Payment" vertex="1">
          <mxGeometry x="300" y="400" width="200" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="wf-bk-02-conflict" name="Submit Booking — Conflict">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="3" pageScale="1" pageWidth="800" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- Background elements (similar to form view, faded) -->
        <mxCell id="bg_blur" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcfcfc;strokeColor=#cccccc;opacity=60;" value="" vertex="1">
          <mxGeometry x="10" y="10" width="780" height="580" as="geometry" />
        </mxCell>
        <!-- Modal Overlay -->
        <mxCell id="modal" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;shadow=1;arcSize=4;" value="" vertex="1">
          <mxGeometry x="200" y="150" width="400" height="250" as="geometry" />
        </mxCell>
        <!-- Icon -->
        <mxCell id="icon" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f2dede;strokeColor=#ebccd1;fontSize=24;fontColor=#a94442;" value="✕" vertex="1">
          <mxGeometry x="370" y="170" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#333333;" value="Dates No Longer Available" vertex="1">
          <mxGeometry x="250" y="240" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="msg" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=12;fontColor=#a94442;" value="Sorry, another user has just booked some or all of the dates&lt;br&gt;you selected. Please choose different dates." vertex="1">
          <mxGeometry x="220" y="280" width="360" height="40" as="geometry" />
        </mxCell>
        <mxCell id="btn_back" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#cccccc;fontColor=#333333;fontSize=11;fontStyle=1;" value="Return to Calendar" vertex="1">
          <mxGeometry x="310" y="340" width="180" height="36" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
