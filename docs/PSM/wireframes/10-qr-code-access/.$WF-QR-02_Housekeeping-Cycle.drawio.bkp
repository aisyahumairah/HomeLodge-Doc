        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#333333;" value="Housekeeping QR Codes" vertex="1">
          <mxGeometry x="240" y="50" width="300" height="30" as="geometry" />
        </mxCell>

        <mxCell id="desc" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" value="Manage the static QR codes placed in each unit for housekeeping staff to scan." vertex="1">
          <mxGeometry x="240" y="80" width="510" height="20" as="geometry" />
        </mxCell>

        <!-- Filter -->
        <mxCell id="f_search" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;align=left;spacingLeft=10;fontSize=11;fontColor=#999999;" value="🔍 Search Unit Name..." vertex="1">
          <mxGeometry x="240" y="120" width="250" height="30" as="geometry" />
        </mxCell>

        <!-- Table -->
        <mxCell id="tbl_bg" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" value="" vertex="1">
          <mxGeometry x="240" y="170" width="510" height="200" as="geometry" />
        </mxCell>
        <mxCell id="tbl_head" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#cccccc;" value="" vertex="1">
          <mxGeometry x="240" y="170" width="510" height="30" as="geometry" />
        </mxCell>
        <mxCell id="th1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#333333;" value="Homestay Unit" vertex="1"><mxGeometry x="250" y="175" width="200" height="20" as="geometry" /></mxCell>
        <mxCell id="th2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#333333;" value="Actions" vertex="1"><mxGeometry x="500" y="175" width="240" height="20" as="geometry" /></mxCell>
        
        <!-- Row 1 -->
        <mxCell id="td1_1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" value="&lt;b&gt;Unit 104&lt;/b&gt;&lt;br&gt;Sunset Villa" vertex="1"><mxGeometry x="250" y="210" width="200" height="30" as="geometry" /></mxCell>
        <mxCell id="td1_btn1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#cccccc;fontColor=#333333;fontSize=10;" value="🖨 Print QR" vertex="1"><mxGeometry x="480" y="210" width="80" height="30" as="geometry" /></mxCell>
        <mxCell id="td1_btn2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcf8e3;strokeColor=#faebcc;fontColor=#8a6d3b;fontSize=10;fontStyle=1;" value="↻ Regenerate QR" vertex="1"><mxGeometry x="570" y="210" width="120" height="30" as="geometry" /></mxCell>
        <mxCell id="row1_line" parent="1" style="line;strokeColor=#eeeeee;html=1;" value="" vertex="1"><mxGeometry x="240" y="250" width="510" height="1" as="geometry" /></mxCell>
        
        <!-- Row 2 -->
        <mxCell id="td2_1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" value="&lt;b&gt;Unit 201&lt;/b&gt;&lt;br&gt;Ocean View Suite" vertex="1"><mxGeometry x="250" y="260" width="200" height="30" as="geometry" /></mxCell>
        <mxCell id="td2_btn1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#cccccc;fontColor=#333333;fontSize=10;" value="🖨 Print QR" vertex="1"><mxGeometry x="480" y="260" width="80" height="30" as="geometry" /></mxCell>
        <mxCell id="td2_btn2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcf8e3;strokeColor=#faebcc;fontColor=#8a6d3b;fontSize=10;fontStyle=1;" value="↻ Regenerate QR" vertex="1"><mxGeometry x="570" y="260" width="120" height="30" as="geometry" /></mxCell>
        <mxCell id="row2_line" parent="1" style="line;strokeColor=#eeeeee;html=1;" value="" vertex="1"><mxGeometry x="240" y="300" width="510" height="1" as="geometry" /></mxCell>

        <!-- Regeneration Alert Note -->
        <mxCell id="alert_bg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9edf7;strokeColor=#bce8f1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;fontColor=#31708f;" value="&lt;b&gt;Note:&lt;/b&gt; Regenerating a Housekeeping QR code will immediately invalidate the old code. You must print and physically replace the QR code inside the unit." vertex="1">
          <mxGeometry x="240" y="390" width="510" height="50" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- Page 3: Housekeeper Desktop Web View -->
