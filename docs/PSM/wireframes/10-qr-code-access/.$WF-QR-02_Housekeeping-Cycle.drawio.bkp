          <mxGeometry x="250" y="260" width="500" height="250" as="geometry" />
        </mxCell>
        
        <mxCell id="desc_start" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontColor=#666666;" value="Please start the cleaning timer when you enter the unit.&lt;br&gt;This allows the system to track turnover time." vertex="1">
          <mxGeometry x="300" y="290" width="400" height="40" as="geometry" />
