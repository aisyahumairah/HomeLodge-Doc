<mxfile host="Electron" agent="HomeLodge-Doc" pages="3">
  <!-- Page 1: Housekeeper Mobile View -->
  <diagram id="wf-qr-02-mobile" name="Manage Housekeeping Cycle">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="400" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Mobile Device Frame -->
        <mxCell id="frame" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;arcSize=10;" value="" vertex="1">
          <mxGeometry x="20" y="20" width="360" height="660" as="geometry" />
        </mxCell>
        <!-- Status Bar -->
        <mxCell id="status" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontColor=#333333;" value="10:00 &amp;nbsp;&amp;nbsp;&amp;nbsp; 📶 🔋" vertex="1">
          <mxGeometry x="20" y="25" width="360" height="20" as="geometry" />
        </mxCell>
        
        <!-- Navbar -->
        <mxCell id="navbar" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4A90D9;strokeColor=none;" value="" vertex="1">
          <mxGeometry x="20" y="50" width="360" height="50" as="geometry" />
        </mxCell>
        <mxCell id="nav_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=16;fontColor=#ffffff;fontStyle=1;" value="Housekeeping Mode" vertex="1">
          <mxGeometry x="80" y="60" width="240" height="30" as="geometry" />
        </mxCell>
        <mxCell id="nav_menu" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontColor=#ffffff;fontStyle=1;" value="≡" vertex="1">
          <mxGeometry x="30" y="60" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- Room Header Scanned via QR -->
        <mxCell id="room_header" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#333333;" value="Unit 104 (Sunset Villa)" vertex="1">
          <mxGeometry x="40" y="120" width="320" height="30" as="geometry" />
        </mxCell>
        <mxCell id="room_status" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcf8e3;strokeColor=#faebcc;fontColor=#8a6d3b;fontSize=11;align=center;" value="Status: Dirty" vertex="1">
          <mxGeometry x="150" y="160" width="100" height="20" as="geometry" />
        </mxCell>
        
        <!-- Action Buttons -->
        <!-- State 1: Start Cleaning -->
        <mxCell id="box_start" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#cccccc;arcSize=5;" value="" vertex="1">
          <mxGeometry x="40" y="210" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="desc_start" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="Guest checked out. Unit requires cleaning." vertex="1">
          <mxGeometry x="60" y="230" width="280" height="30" as="geometry" />
        </mxCell>
        <mxCell id="btn_start" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0ad4e;strokeColor=none;fontColor=#ffffff;fontSize=14;fontStyle=1;" value="▶ Start Cleaning" vertex="1">
          <mxGeometry x="80" y="280" width="240" height="50" as="geometry" />
        </mxCell>

        <!-- Divider -->
        <mxCell id="div_line" parent="1" style="line;strokeColor=#eeeeee;html=1;strokeWidth=2;" value="" vertex="1">
          <mxGeometry x="40" y="390" width="320" height="1" as="geometry" />
        </mxCell>
        
        <!-- State 2: End Cleaning (Shown conditionally) -->
        <mxCell id="box_end" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#cccccc;arcSize=5;" value="" vertex="1">
          <mxGeometry x="40" y="420" width="320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="desc_end" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="Cleaning in progress since 10:05 AM." vertex="1">
          <mxGeometry x="60" y="440" width="280" height="30" as="geometry" />
        </mxCell>
        <mxCell id="btn_end" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5cb85c;strokeColor=none;fontColor=#ffffff;fontSize=14;fontStyle=1;" value="✓ End Cleaning &amp; Mark Ready" vertex="1">
          <mxGeometry x="60" y="500" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="note_end" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontColor=#999999;" value="*This will notify the next guest if early check-in is allowed." vertex="1">
          <mxGeometry x="60" y="560" width="280" height="30" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
  
  <!-- Page 2: Admin Regenerate QR -->
  <diagram id="wf-qr-02-admin" name="Admin - Regenerate HK QR">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="2" pageScale="1" pageWidth="800" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="frame" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;arcSize=4;" value="" vertex="1">
          <mxGeometry x="10" y="10" width="780" height="580" as="geometry" />
        </mxCell>
        <!-- Sidebar Navigation -->
        <mxCell id="sidebar" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;" value="" vertex="1">
          <mxGeometry x="10" y="35" width="200" height="555" as="geometry" />
        </mxCell>
        <mxCell id="nav_hk" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=none;align=left;spacingLeft=15;fontSize=11;fontColor=#333333;fontStyle=1;" value="Homestays &gt; HK QR Codes" vertex="1">
          <mxGeometry x="10" y="140" width="200" height="40" as="geometry" />
