          <mxGeometry x="570" y="230" width="200" height="200" as="geometry" />
        </mxCell>
        <mxCell id="qr_p1_2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;" value="" vertex="1"><mxGeometry x="580" y="240" width="40" height="40" as="geometry" /></mxCell>
        <mxCell id="qr_p2_2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;" value="" vertex="1"><mxGeometry x="720" y="240" width="40" height="40" as="geometry" /></mxCell>
        <mxCell id="qr_p3_2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;" value="" vertex="1"><mxGeometry x="580" y="380" width="40" height="40" as="geometry" /></mxCell>
        
