        </mxCell>
        <mxCell id="nav_links" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=14;fontColor=#666666;" value="Home &amp;nbsp;&amp;nbsp;&amp;nbsp; Destinations &amp;nbsp;&amp;nbsp;&amp;nbsp; Help &amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;b&gt;Jane Doe 👤&lt;/b&gt;" vertex="1">
          <mxGeometry x="500" y="65" width="450" height="30" as="geometry" />
        </mxCell>

        <!-- Main Container -->
        <mxCell id="main_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcfcfc;strokeColor=#cccccc;" value="" vertex="1">
          <mxGeometry x="140" y="150" width="720" height="450" as="geometry" />
        </mxCell>

        <!-- Booking Details (Left) -->
        <mxCell id="bkg_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#333333;" value="Your Digital Key" vertex="1">
          <mxGeometry x="180" y="180" width="300" height="40" as="geometry" />
        </mxCell>
        
        <mxCell id="bkg_name2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#333333;" value="Sunset Villa (Unit 104)" vertex="1">
          <mxGeometry x="180" y="240" width="300" height="20" as="geometry" />
