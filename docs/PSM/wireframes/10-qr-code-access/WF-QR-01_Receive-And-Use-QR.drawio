          <mxGeometry x="180" y="330" width="100" height="30" as="geometry" />
        </mxCell>
        
        <mxCell id="inst_desc" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;" value="&lt;b&gt;Instructions:&lt;/b&gt;&lt;br&gt;1. Increase your screen brightness.&lt;br&gt;2. Hold this QR code near the scanner at the door lock.&lt;br&gt;3. Ensure the full code is visible to the scanner." vertex="1">
