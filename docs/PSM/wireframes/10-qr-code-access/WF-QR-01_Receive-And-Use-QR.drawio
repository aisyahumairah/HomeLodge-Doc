<mxfile host="Electron" agent="HomeLodge-Doc" pages="2">
  <!-- Page 1: Receive & Use QR (Mobile App) -->
  <diagram id="wf-qr-01-mobile" name="Receive QR (Mobile App)">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="400" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Mobile Device Frame -->
        <mxCell id="frame" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;arcSize=10;" value="" vertex="1">
          <mxGeometry x="20" y="20" width="360" height="660" as="geometry" />
        </mxCell>
        <!-- Status Bar -->
        <mxCell id="status" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontColor=#333333;" value="14:15 &amp;nbsp;&amp;nbsp;&amp;nbsp; 📶 🔋" vertex="1">
          <mxGeometry x="20" y="25" width="360" height="20" as="geometry" />
        </mxCell>
        
        <!-- Navbar -->
        <mxCell id="navbar" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4A90D9;strokeColor=none;" value="" vertex="1">
          <mxGeometry x="20" y="50" width="360" height="50" as="geometry" />
        </mxCell>
        <mxCell id="nav_back" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontColor=#ffffff;fontStyle=1;" value="&lt;" vertex="1">
          <mxGeometry x="30" y="60" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="nav_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=16;fontColor=#ffffff;fontStyle=1;" value="Digital Key" vertex="1">
          <mxGeometry x="100" y="60" width="200" height="30" as="geometry" />
        </mxCell>

        <!-- Booking Details -->
        <mxCell id="bkg_card" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#cccccc;arcSize=5;" value="" vertex="1">
          <mxGeometry x="40" y="120" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="bkg_name" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#333333;" value="Sunset Villa" vertex="1">
          <mxGeometry x="50" y="130" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="bkg_unit" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="Unit 104" vertex="1">
          <mxGeometry x="50" y="150" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="bkg_dates" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#4A90D9;" value="01 Nov - 07 Nov 2025" vertex="1">
          <mxGeometry x="50" y="170" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="bkg_status" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff0d8;strokeColor=#d6e9c6;fontColor=#3c763d;fontSize=10;align=center;" value="Active" vertex="1">
          <mxGeometry x="280" y="132" width="60" height="18" as="geometry" />
        </mxCell>

        <!-- QR Code Area -->
        <mxCell id="qr_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;shadow=1;arcSize=5;" value="" vertex="1">
          <mxGeometry x="50" y="240" width="300" height="300" as="geometry" />
        </mxCell>
        <mxCell id="qr_img" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;" value="" vertex="1">
          <mxGeometry x="100" y="270" width="200" height="200" as="geometry" />
        </mxCell>
        <!-- QR Code Pattern Simulation -->
        <mxCell id="qr_p1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;" value="" vertex="1"><mxGeometry x="110" y="280" width="40" height="40" as="geometry" /></mxCell>
        <mxCell id="qr_p2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;" value="" vertex="1"><mxGeometry x="250" y="280" width="40" height="40" as="geometry" /></mxCell>
        <mxCell id="qr_p3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;" value="" vertex="1"><mxGeometry x="110" y="420" width="40" height="40" as="geometry" /></mxCell>
        
        <mxCell id="qr_desc" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#666666;" value="Hold this QR code near the scanner&lt;br&gt;at the door lock to enter." vertex="1">
          <mxGeometry x="60" y="490" width="280" height="30" as="geometry" />
        </mxCell>

        <!-- Generate New Code Button -->
        <mxCell id="btn_refresh" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#cccccc;fontColor=#333333;fontSize=12;" value="↻ Refresh Key" vertex="1">
          <mxGeometry x="130" y="580" width="140" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  
  <!-- Page 2: Receive & Use QR (Desktop Web) -->
  <diagram id="wf-qr-01-web" name="Receive QR (Desktop Web)">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="2" pageScale="1" pageWidth="1000" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Web Browser Window -->
