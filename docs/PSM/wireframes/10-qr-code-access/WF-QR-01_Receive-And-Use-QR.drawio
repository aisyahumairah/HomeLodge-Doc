        <mxCell id="bkg_dates2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#666666;" value="Check-in: 01 Nov 2025, 2:00 PM&lt;br&gt;Check-out: 07 Nov 2025, 12:00 PM" vertex="1">
          <mxGeometry x="180" y="270" width="300" height="40" as="geometry" />
