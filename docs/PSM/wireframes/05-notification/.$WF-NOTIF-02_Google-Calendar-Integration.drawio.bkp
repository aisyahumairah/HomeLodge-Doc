        </mxCell>
        <mxCell id="gcal2_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#333333;" value="Google Calendar Sync" vertex="1">
          <mxGeometry x="330" y="300" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="gcal2_status" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#cccccc;fontColor=#666666;fontSize=9;align=center;" value="Disconnected" vertex="1">
          <mxGeometry x="330" y="325" width="80" height="18" as="geometry" />
        </mxCell>
        <mxCell id="gcal2_desc" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;" value="Automatically syncs confirmed bookings to your connected Google Calendar. Bookings are synced as all-day events across the check-in and check-out dates." vertex="1">
