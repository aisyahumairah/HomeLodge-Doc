<mxfile host="Electron" agent="HomeLodge-Doc" pages="1">
  <diagram id="wf-notif-02" name="Google Calendar Integration (Admin)">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="frame" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;arcSize=4;" value="" vertex="1">
          <mxGeometry x="10" y="10" width="780" height="580" as="geometry" />
        </mxCell>
        <!-- Sidebar -->
        <mxCell id="sidebar" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;" value="" vertex="1">
          <mxGeometry x="10" y="35" width="200" height="555" as="geometry" />
        </mxCell>
        <!-- Header -->
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#333333;" value="Integrations &amp; Settings" vertex="1">
          <mxGeometry x="240" y="50" width="300" height="30" as="geometry" />
        </mxCell>
        <!-- Integration Box -->
        <mxCell id="int_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;shadow=1;arcSize=4;" value="" vertex="1">
          <mxGeometry x="240" y="100" width="510" height="150" as="geometry" />
        </mxCell>
        <!-- Connected State -->
        <mxCell id="gcal_icon" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#cccccc;fontSize=16;" value="G" vertex="1">
          <mxGeometry x="260" y="120" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="gcal_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#333333;" value="Google Calendar Sync" vertex="1">
          <mxGeometry x="330" y="120" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="gcal_status" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff0d8;strokeColor=#d6e9c6;fontColor=#3c763d;fontSize=9;align=center;" value="Connected" vertex="1">
          <mxGeometry x="330" y="145" width="70" height="18" as="geometry" />
        </mxCell>
        <mxCell id="gcal_acct" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" value="admin@homelodge.example.com" vertex="1">
          <mxGeometry x="410" y="144" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="gcal_desc" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;" value="Automatically syncs confirmed bookings to your connected Google Calendar. Bookings are synced as all-day events across the check-in and check-out dates." vertex="1">
          <mxGeometry x="260" y="190" width="470" height="40" as="geometry" />
        </mxCell>
        <mxCell id="btn_disconnect" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9534f;fontColor=#d9534f;fontSize=11;fontStyle=1;" value="Disconnect" vertex="1">
          <mxGeometry x="640" y="130" width="90" height="30" as="geometry" />
        </mxCell>
        
        <!-- Disconnected State Simulation Box -->
        <mxCell id="int2_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;shadow=1;arcSize=4;" value="" vertex="1">
          <mxGeometry x="240" y="280" width="510" height="150" as="geometry" />
        </mxCell>
        <mxCell id="gcal2_icon" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#cccccc;fontSize=16;" value="G" vertex="1">
