        <mxCell id="inp_reply" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=12;fontColor=#333333;" value="Thank you for the feedback! We are upgrading our router next week." vertex="1">
          <mxGeometry x="220" y="300" width="360" height="80" as="geometry" />
        </mxCell>

        <!-- Buttons -->
        <mxCell id="btn_cancel" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#cccccc;fontColor=#333333;fontSize=11;" value="Cancel" vertex="1">
          <mxGeometry x="380" y="410" width="90" height="36" as="geometry" />
        </mxCell>
        <mxCell id="btn_post" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4A90D9;strokeColor=none;fontColor=#ffffff;fontSize=11;fontStyle=1;" value="Post Reply" vertex="1">
          <mxGeometry x="480" y="410" width="100" height="36" as="geometry" />
        </mxCell>
