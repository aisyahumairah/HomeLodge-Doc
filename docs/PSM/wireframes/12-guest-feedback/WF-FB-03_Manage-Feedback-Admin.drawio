        <!-- Header -->
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#333333;" value="Guest Feedback &amp; Reviews" vertex="1">
          <mxGeometry x="240" y="50" width="300" height="30" as="geometry" />
        </mxCell>

        <!-- Filters -->
        <mxCell id="f_unit" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;align=left;spacingLeft=10;fontSize=11;fontColor=#333333;" value="All Units ▼" vertex="1">
          <mxGeometry x="240" y="100" width="120" height="30" as="geometry" />
