<mxfile host="Electron" agent="HomeLodge-Doc" pages="2">
  <!-- Page 1: Submit Feedback Form -->
  <diagram id="wf-fb-01" name="Submit Rating &amp; Feedback">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="frame" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;arcSize=4;" value="" vertex="1">
          <mxGeometry x="10" y="10" width="780" height="580" as="geometry" />
        </mxCell>
        <!-- Navbar -->
        <mxCell id="navbar" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;" value="" vertex="1">
          <mxGeometry x="10" y="10" width="780" height="50" as="geometry" />
        </mxCell>
        <mxCell id="logo" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#333333;" value="HomeLodge" vertex="1">
          <mxGeometry x="30" y="20" width="140" height="30" as="geometry" />
        </mxCell>
        <mxCell id="nav_links" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="Home &amp;nbsp;&amp;nbsp;&amp;nbsp; My Bookings &amp;nbsp;&amp;nbsp;&amp;nbsp; Profile" vertex="1">
          <mxGeometry x="500" y="20" width="250" height="30" as="geometry" />
        </mxCell>

        <!-- Content Area -->
        <mxCell id="content_bg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcfcfc;strokeColor=#cccccc;" value="" vertex="1">
          <mxGeometry x="140" y="100" width="520" height="420" as="geometry" />
        </mxCell>
        
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#333333;" value="Rate Your Stay" vertex="1">
          <mxGeometry x="250" y="130" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="desc" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="How was your stay at &lt;b&gt;Sunset Villa (Unit 104)&lt;/b&gt;?&lt;br&gt;Your feedback helps us improve." vertex="1">
          <mxGeometry x="200" y="160" width="400" height="40" as="geometry" />
        </mxCell>

        <!-- Star Rating -->
        <mxCell id="stars" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=36;fontColor=#f0ad4e;" value="★ ★ ★ ★ ☆" vertex="1">
          <mxGeometry x="250" y="210" width="300" height="40" as="geometry" />
        </mxCell>

        <!-- Comments -->
        <mxCell id="lbl_comment" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#333333;" value="Share your experience (Optional)" vertex="1">
          <mxGeometry x="180" y="270" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="inp_comment" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=12;fontColor=#999999;" value="The place was great and clean, but the Wi-Fi was a bit slow..." vertex="1">
          <mxGeometry x="180" y="290" width="440" height="100" as="geometry" />
        </mxCell>

        <!-- Submit Button -->
        <mxCell id="btn_submit" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4A90D9;strokeColor=none;fontColor=#ffffff;fontSize=14;fontStyle=1;" value="Submit Feedback" vertex="1">
          <mxGeometry x="180" y="420" width="440" height="40" as="geometry" />
        </mxCell>
        <mxCell id="btn_skip" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#999999;fontStyle=4;" value="Skip for now" vertex="1">
          <mxGeometry x="350" y="470" width="100" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  
  <!-- Page 2: View Submitted Feedback -->
