<mxfile host="Electron" agent="HomeLodge-Doc" pages="1">
  <diagram id="wf-fb-04" name="Display Average Rating">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="frame" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;arcSize=4;" value="" vertex="1">
          <mxGeometry x="10" y="10" width="780" height="580" as="geometry" />
        </mxCell>
        
        <!-- Header / Context -->
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#333333;" value="Homestay Listing Card Component (Guest View)" vertex="1">
          <mxGeometry x="40" y="30" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="desc" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" value="Illustrates how the average system rating (UC-FB-04) is displayed to the user." vertex="1">
          <mxGeometry x="40" y="60" width="400" height="20" as="geometry" />
        </mxCell>

        <!-- Homestay Card -->
        <mxCell id="card_bg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;shadow=1;arcSize=5;" value="" vertex="1">
          <mxGeometry x="40" y="120" width="300" height="320" as="geometry" />
        </mxCell>
        
        <!-- Image Placeholder -->
        <mxCell id="img_bg" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=none;" value="" vertex="1">
          <mxGeometry x="40" y="120" width="300" height="180" as="geometry" />
        </mxCell>
        <mxCell id="img_icon" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=36;fontColor=#cccccc;" value="📷" vertex="1">
          <mxGeometry x="170" y="190" width="40" height="40" as="geometry" />
        </mxCell>

        <!-- Details Area -->
        <mxCell id="hs_name" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#333333;" value="Sunset Villa" vertex="1">
          <mxGeometry x="50" y="310" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="hs_loc" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#999999;" value="Penang, Malaysia" vertex="1">
          <mxGeometry x="50" y="330" width="200" height="20" as="geometry" />
        </mxCell>

        <!-- Average Rating UI (Focus of UC-FB-04) -->
        <mxCell id="badge_bg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcf8e3;strokeColor=#faebcc;arcSize=5;" value="" vertex="1">
          <mxGeometry x="50" y="360" width="100" height="24" as="geometry" />
        </mxCell>
        <mxCell id="badge_star" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#f0ad4e;" value="★" vertex="1">
          <mxGeometry x="55" y="362" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="badge_score" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#8a6d3b;" value="4.8" vertex="1">
          <mxGeometry x="75" y="362" width="30" height="20" as="geometry" />
        </mxCell>
        <mxCell id="badge_count" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#8a6d3b;" value="(124)" vertex="1">
          <mxGeometry x="105" y="362" width="40" height="20" as="geometry" />
        </mxCell>

        <!-- Price -->
        <mxCell id="hs_price" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#4A90D9;" value="RM 250 / night" vertex="1">
          <mxGeometry x="200" y="390" width="130" height="30" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
