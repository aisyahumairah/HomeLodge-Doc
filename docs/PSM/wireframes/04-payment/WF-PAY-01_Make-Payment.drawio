<mxfile host="Electron" agent="HomeLodge-Doc" pages="3">
  <!-- Payment Gateway Selection / Start -->
  <diagram id="wf-pay-01-start" name="Make Payment — Select Method">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="frame" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;arcSize=4;" value="" vertex="1">
          <mxGeometry x="10" y="10" width="780" height="580" as="geometry" />
        </mxCell>
        <mxCell id="header" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;" value="" vertex="1">
          <mxGeometry x="10" y="10" width="780" height="60" as="geometry" />
        </mxCell>
        <mxCell id="logo" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#333333;" value="HomeLodge" vertex="1">
          <mxGeometry x="30" y="25" width="140" height="30" as="geometry" />
        </mxCell>
        <!-- Content -->
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#333333;" value="Complete Your Payment" vertex="1">
          <mxGeometry x="240" y="100" width="300" height="30" as="geometry" />
        </mxCell>
        <!-- Summary Box -->
        <mxCell id="sum_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#cccccc;arcSize=4;" value="" vertex="1">
          <mxGeometry x="240" y="150" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="sum_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#666666;" value="Booking Reference: #BKG-20260601" vertex="1">
          <mxGeometry x="260" y="160" width="250" height="20" as="geometry" />
        </mxCell>
        <mxCell id="sum_desc" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#333333;" value="Sunset Villa (11 Jun - 14 Jun)" vertex="1">
          <mxGeometry x="260" y="190" width="250" height="20" as="geometry" />
        </mxCell>
        <mxCell id="sum_amt" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#4A90D9;" value="Total to Pay: RM 850.00" vertex="1">
          <mxGeometry x="260" y="220" width="250" height="30" as="geometry" />
        </mxCell>
        <!-- Payment Options -->
        <mxCell id="opt_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#333333;" value="Select Payment Method" vertex="1">
          <mxGeometry x="240" y="300" width="200" height="20" as="geometry" />
        </mxCell>
        <!-- Option 1: FPX -->
        <mxCell id="opt1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4A90D9;strokeWidth=2;align=left;spacingLeft=40;fontSize=12;fontColor=#333333;" value="Online Banking (FPX)" vertex="1">
          <mxGeometry x="240" y="330" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="opt1_chk" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#4A90D9;strokeColor=none;" value="" vertex="1">
          <mxGeometry x="255" y="348" width="14" height="14" as="geometry" />
        </mxCell>
        <!-- Option 2: Card -->
        <mxCell id="opt2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;align=left;spacingLeft=40;fontSize=12;fontColor=#333333;" value="Credit / Debit Card" vertex="1">
          <mxGeometry x="240" y="390" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="opt2_chk" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" value="" vertex="1">
          <mxGeometry x="255" y="408" width="14" height="14" as="geometry" />
        </mxCell>
        <!-- Action -->
        <mxCell id="btn_pay" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5cb85c;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;" value="Proceed to ToyyibPay" vertex="1">
          <mxGeometry x="240" y="470" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="sec_note" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=9;fontColor=#999999;" value="🔒 Secure payment processed by ToyyibPay" vertex="1">
          <mxGeometry x="240" y="520" width="300" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  
  <!-- Gateway Simulation & Success -->
  <diagram id="wf-pay-01-success" name="Make Payment — Success">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="2" pageScale="1" pageWidth="800" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="frame" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;arcSize=4;" value="" vertex="1">
          <mxGeometry x="10" y="10" width="780" height="580" as="geometry" />
        </mxCell>
        <!-- Success State -->
        <mxCell id="icon" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dff0d8;strokeColor=#d6e9c6;fontSize=36;fontColor=#3c763d;" value="✓" vertex="1">
          <mxGeometry x="350" y="150" width="100" height="100" as="geometry" />
        </mxCell>
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#333333;" value="Payment Successful!" vertex="1">
          <mxGeometry x="250" y="270" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="msg" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=12;fontColor=#666666;" value="Your payment of &lt;b&gt;RM 850.00&lt;/b&gt; has been received.&lt;br&gt;Your booking (#BKG-20260601) is now confirmed.&lt;br&gt;A receipt has been emailed to you." vertex="1">
          <mxGeometry x="200" y="310" width="400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="btn_view" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4A90D9;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;" value="View Booking Details" vertex="1">
          <mxGeometry x="300" y="400" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="btn_receipt" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontColor=#4A90D9;fontStyle=4;" value="Download Receipt" vertex="1">
          <mxGeometry x="300" y="450" width="200" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  
  <!-- Failure -->
  <diagram id="wf-pay-01-fail" name="Make Payment — Failed">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="3" pageScale="1" pageWidth="800" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="frame" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;arcSize=4;" value="" vertex="1">
          <mxGeometry x="10" y="10" width="780" height="580" as="geometry" />
        </mxCell>
        <!-- Failed State -->
        <mxCell id="icon" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f2dede;strokeColor=#ebccd1;fontSize=36;fontColor=#a94442;" value="✕" vertex="1">
          <mxGeometry x="350" y="150" width="100" height="100" as="geometry" />
        </mxCell>
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#333333;" value="Payment Failed or Cancelled" vertex="1">
          <mxGeometry x="250" y="270" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="msg" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=12;fontColor=#666666;" value="We were unable to process your payment.&lt;br&gt;Your booking remains in 'Pending' status.&lt;br&gt;&lt;br&gt;&lt;b&gt;You have until 12 Jun 2026, 15:00 to complete payment before the reservation expires.&lt;/b&gt;" vertex="1">
          <mxGeometry x="150" y="310" width="500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="btn_retry" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5cb85c;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;" value="Retry Payment" vertex="1">
          <mxGeometry x="300" y="400" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="btn_later" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#cccccc;fontColor=#333333;fontSize=12;" value="Pay Later" vertex="1">
          <mxGeometry x="300" y="450" width="200" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
