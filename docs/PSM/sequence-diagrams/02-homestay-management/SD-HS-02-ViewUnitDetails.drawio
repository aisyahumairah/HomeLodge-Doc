        <!-- M9 -->
        <mxCell id="m9" value="9: clickBookNow(unitId)  →  UC-BK-01" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
