        <!-- M4 -->
        <mxCell id="m4" value="4: unitData(name, photos, description, price, deposit,&#xa;   checkIn/Out times, houseRules, reviews)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
