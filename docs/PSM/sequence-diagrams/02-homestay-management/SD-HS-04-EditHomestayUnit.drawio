            <mxPoint x="920" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- M4 -->
        <mxCell id="m4" value="4: currentUnitData" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
