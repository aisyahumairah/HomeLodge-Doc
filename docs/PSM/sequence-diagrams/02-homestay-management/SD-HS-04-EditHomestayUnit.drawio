              <mxPoint x="720" y="400" />
              <mxPoint x="720" y="420" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- M10 -->
        <mxCell id="m10" value="10: updateUnitRecord(unitId, updatedData)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
