            <mxPoint x="160" y="260" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- M6 -->
        <mxCell id="m6" value="6: modifyFields(name, description, pricing,&#xa;   times, photos, houseRules, extensionWindow)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
