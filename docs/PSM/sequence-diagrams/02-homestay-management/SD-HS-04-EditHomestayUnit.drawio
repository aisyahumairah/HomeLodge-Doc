        <mxCell id="alt1-label" value="[Invalid information entered] — Highlight problem fields, keep entered values" style="text;html=1;fontSize=10;fontStyle=2;align=left;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="1">
