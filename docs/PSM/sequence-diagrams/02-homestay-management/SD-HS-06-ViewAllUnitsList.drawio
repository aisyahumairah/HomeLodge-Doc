          <mxGeometry x="860" y="70" width="120" height="470" as="geometry" />
        </mxCell>

        <!-- M1 -->
        <mxCell id="m1" value="1: navigateToHomestayManagement()" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="160" y="150" as="sourcePoint" />
