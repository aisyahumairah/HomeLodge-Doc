<mxfile host="Electron" agent="HomeLodge-Doc">
  <diagram id="sd-auth-02" name="SD-AUTH-02 Login">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="SD-AUTH-02: Login / Login via Google SSO" style="text;html=1;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="500" height="30" as="geometry" />
        </mxCell>

        <!-- ============================================ -->
        <!-- Lifelines                                     -->
        <!-- ============================================ -->
        <mxCell id="ll-user" value="User&#xa;(Guest / Registered&#xa;User / Admin)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="70" width="130" height="1250" as="geometry" />
        </mxCell>

        <mxCell id="ll-loginpage" value="Login Page" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="70" width="120" height="1250" as="geometry" />
        </mxCell>

        <mxCell id="ll-system" value="System" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="70" width="120" height="1250" as="geometry" />
        </mxCell>

        <mxCell id="ll-db" value="Database" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="70" width="120" height="1250" as="geometry" />
        </mxCell>

        <mxCell id="ll-google" value="Google SSO&#xa;Service" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1060" y="70" width="120" height="1250" as="geometry" />
        </mxCell>

        <!-- ============================================ -->
        <!-- ALT Frame: Email/Password vs Google SSO       -->
        <!-- ============================================ -->
        <mxCell id="alt-main" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=30;height=20;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=5;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="1150" height="1070" as="geometry" />
        </mxCell>

        <!-- ============================================ -->
        <!-- Fragment Label: Email & Password              -->
        <!-- ============================================ -->
        <mxCell id="frag-email-label" value="[Email &amp; Password Login]" style="text;html=1;fontSize=11;fontStyle=3;align=left;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="100" y="160" width="200" height="20" as="geometry" />
        </mxCell>

        <!-- M1: Open login page -->
        <mxCell id="m1" value="1: openLoginPage()" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="145" y="190" as="sourcePoint" />
            <mxPoint x="400" y="190" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- M2: Display login form -->
        <mxCell id="m2" value="2: displayLoginForm()" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="400" y="220" as="sourcePoint" />
            <mxPoint x="145" y="220" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- M3: Enter credentials -->
        <mxCell id="m3" value="3: enterCredentials(email, password)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="145" y="260" as="sourcePoint" />
            <mxPoint x="400" y="260" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- M4: Submit login -->
        <mxCell id="m4" value="4: submitLogin(email, password)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="400" y="290" as="sourcePoint" />
            <mxPoint x="640" y="290" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- M5: Verify credentials -->
        <mxCell id="m5" value="5: verifyCredentials(email, password)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="640" y="320" as="sourcePoint" />
            <mxPoint x="880" y="320" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- M6: Return credentials valid -->
        <mxCell id="m6" value="6: credentialsValid" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="880" y="350" as="sourcePoint" />
            <mxPoint x="640" y="350" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- M7: Check account status -->
        <mxCell id="m7" value="7: checkAccountStatus(userId)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="640" y="380" as="sourcePoint" />
            <mxPoint x="880" y="380" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- M8: Account active -->
        <mxCell id="m8" value="8: accountActive, notLocked" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="880" y="410" as="sourcePoint" />
            <mxPoint x="640" y="410" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- M9: Create session -->
        <mxCell id="m9" value="9: createSession(userId), recordLoginTime()" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="640" y="440" as="sourcePoint" />
            <mxPoint x="880" y="440" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- M10: Session created -->
        <mxCell id="m10" value="10: sessionCreated" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="880" y="470" as="sourcePoint" />
            <mxPoint x="640" y="470" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Opt: Force change password check -->
        <mxCell id="opt-fcp" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=30;height=20;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=5;fontSize=11;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="100" y="490" width="870" height="70" as="geometry" />
        </mxCell>
        <mxCell id="opt-fcp-label" value="[forcePasswordChange = true] — Redirect to Force Change Password page (UC-AUTH-06)" style="text;html=1;fontSize=10;fontStyle=2;align=left;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="140" y="510" width="700" height="30" as="geometry" />
        </mxCell>

        <!-- M11: Redirect to dashboard -->
        <mxCell id="m11" value="11: redirectToDashboard()" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="640" y="590" as="sourcePoint" />
            <mxPoint x="400" y="590" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- M12: Display dashboard -->
        <mxCell id="m12" value="12: displayDashboard()" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="400" y="620" as="sourcePoint" />
            <mxPoint x="145" y="620" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ============================================ -->
        <!-- Dashed line separator for ALT                 -->
        <!-- ============================================ -->
        <mxCell id="alt-sep" value="" style="endArrow=none;dashed=1;html=1;dashPattern=8 8;strokeWidth=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="660" as="sourcePoint" />
            <mxPoint x="1210" y="660" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ============================================ -->
        <!-- Fragment Label: Google SSO                    -->
        <!-- ============================================ -->
        <mxCell id="frag-google-label" value="[Google SSO Login]" style="text;html=1;fontSize=11;fontStyle=3;align=left;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="100" y="670" width="200" height="20" as="geometry" />
        </mxCell>

        <!-- G1: Click Continue with Google -->
        <mxCell id="g1" value="1: clickContinueWithGoogle()" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="145" y="700" as="sourcePoint" />
            <mxPoint x="400" y="700" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- G2: Redirect to Google -->
        <mxCell id="g2" value="2: redirectToGoogleSSO()" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="400" y="730" as="sourcePoint" />
            <mxPoint x="1120" y="730" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- G3: User authenticates with Google -->
        <mxCell id="g3" value="3: authenticateWithGoogle()" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="145" y="760" as="sourcePoint" />
            <mxPoint x="1120" y="760" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- G4: Return auth token -->
        <mxCell id="g4" value="4: returnAuthToken(name, email, token)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1120" y="800" as="sourcePoint" />
            <mxPoint x="640" y="800" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- G5: Check existing account -->
        <mxCell id="g5" value="5: findAccountByEmail(email)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="640" y="830" as="sourcePoint" />
            <mxPoint x="880" y="830" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- G6: Return result -->
        <mxCell id="g6" value="6: accountResult" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="880" y="860" as="sourcePoint" />
            <mxPoint x="640" y="860" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Alt: account exists vs new -->
        <mxCell id="alt-google-acc" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=30;height=20;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=5;fontSize=11;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="100" y="880" width="870" height="130" as="geometry" />
        </mxCell>
        <mxCell id="alt-ga-label1" value="[Account exists] — linkGoogleIdentity(userId) if not already linked" style="text;html=1;fontSize=10;fontStyle=2;align=left;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="140" y="900" width="500" height="20" as="geometry" />
        </mxCell>
        <!-- Separator -->
        <mxCell id="alt-ga-sep" value="" style="endArrow=none;dashed=1;html=1;dashPattern=8 8;strokeWidth=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="100" y="940" as="sourcePoint" />
            <mxPoint x="970" y="940" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="alt-ga-label2" value="[No account exists] — createAccount(name, email, &quot;Guest&quot; role)" style="text;html=1;fontSize=10;fontStyle=2;align=left;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="140" y="950" width="500" height="20" as="geometry" />
        </mxCell>

        <!-- G7: Create session -->
        <mxCell id="g7" value="7: createSession(userId), recordLoginTime()" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="640" y="1040" as="sourcePoint" />
            <mxPoint x="880" y="1040" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- G8: Session created -->
        <mxCell id="g8" value="8: sessionCreated" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="880" y="1070" as="sourcePoint" />
            <mxPoint x="640" y="1070" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- G9: Redirect to dashboard -->
        <mxCell id="g9" value="9: redirectToDashboard()" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="640" y="1100" as="sourcePoint" />
            <mxPoint x="400" y="1100" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- G10: Display dashboard -->
        <mxCell id="g10" value="10: displayDashboard()" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="400" y="1130" as="sourcePoint" />
            <mxPoint x="145" y="1130" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Alt error fragment -->
        <mxCell id="alt-errors" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=30;height=20;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=5;fontSize=11;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="60" y="1160" width="1150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="alt-err-label" value="[Invalid credentials / Account deactivated / Account locked / Google SSO cancelled] — Display appropriate error message" style="text;html=1;fontSize=10;fontStyle=2;align=left;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="100" y="1165" width="850" height="30" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
