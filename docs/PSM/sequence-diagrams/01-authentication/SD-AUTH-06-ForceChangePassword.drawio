<mxfile host="Electron" agent="HomeLodge-Doc">
  <diagram id="sd-auth-06" name="SD-AUTH-06 Force Change Password">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="SD-AUTH-06: Force Change Password" style="text;html=1;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="400" height="30" as="geometry" />
        </mxCell>

        <!-- ============================================ -->
        <!-- Lifelines                                     -->
        <!-- ============================================ -->
        <mxCell id="ll-user" value="Registered User" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="70" width="130" height="700" as="geometry" />
        </mxCell>

        <mxCell id="ll-changepwpage" value="Change Password&#xa;Page" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=45;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="70" width="140" height="700" as="geometry" />
        </mxCell>

        <mxCell id="ll-system" value="System" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="70" width="120" height="700" as="geometry" />
        </mxCell>

        <mxCell id="ll-db" value="Database" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="70" width="120" height="700" as="geometry" />
        </mxCell>

        <!-- Note: Precondition -->
        <mxCell id="note-pre" value="Precondition: User has signed in with&#xa;a temporary password (admin reset).&#xa;System detected forcePasswordChange = true." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=18;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="250" height="70" as="geometry" />
        </mxCell>

        <!-- M1: System detects force flag -->
        <mxCell id="m1" value="1: detectForcePasswordChangeFlag(userId)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="680" y="220" as="sourcePoint" />
            <mxPoint x="940" y="220" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- M2: Flag true -->
        <mxCell id="m2" value="2: forcePasswordChange = true" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="940" y="250" as="sourcePoint" />
            <mxPoint x="680" y="250" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- M3: Redirect to change password page -->
        <mxCell id="m3" value="3: redirectToChangePasswordPage()" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="680" y="280" as="sourcePoint" />
            <mxPoint x="430" y="280" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- M4: Block all other pages -->
        <mxCell id="m4" value="4: blockAccessToAllOtherPages()" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="690" y="310" as="sourcePoint" />
            <mxPoint x="690" y="330" as="targetPoint" />
            <Array as="points">
              <mxPoint x="740" y="310" />
              <mxPoint x="740" y="330" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- M5: Display change password form -->
        <mxCell id="m5" value="5: displayChangePasswordForm()" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="430" y="360" as="sourcePoint" />
            <mxPoint x="165" y="360" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- M6: Enter new password -->
        <mxCell id="m6" value="6: enterNewPassword(newPassword, confirmPassword)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="165" y="400" as="sourcePoint" />
            <mxPoint x="430" y="400" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- M7: Click Save -->
        <mxCell id="m7" value="7: clickSave()" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="165" y="430" as="sourcePoint" />
            <mxPoint x="430" y="430" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- M8: Submit password change -->
        <mxCell id="m8" value="8: submitPasswordChange(userId, newPassword)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="430" y="460" as="sourcePoint" />
            <mxPoint x="680" y="460" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- M9: Validate not same as temp -->
        <mxCell id="m9" value="9: validateNotSameAsTemporary(newPassword)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="690" y="490" as="sourcePoint" />
            <mxPoint x="690" y="510" as="targetPoint" />
            <Array as="points">
              <mxPoint x="740" y="490" />
              <mxPoint x="740" y="510" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- M10: Validate password strength -->
        <mxCell id="m10" value="10: validatePasswordStrength(newPassword)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="690" y="530" as="sourcePoint" />
            <mxPoint x="690" y="550" as="targetPoint" />
            <Array as="points">
              <mxPoint x="740" y="530" />
              <mxPoint x="740" y="550" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- M11: Hash and save -->
        <mxCell id="m11" value="11: hashAndSaveNewPassword(userId, hashedPassword)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="680" y="570" as="sourcePoint" />
            <mxPoint x="940" y="570" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- M12: Password saved -->
        <mxCell id="m12" value="12: passwordSaved" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="940" y="600" as="sourcePoint" />
            <mxPoint x="680" y="600" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- M13: Clear force flag -->
        <mxCell id="m13" value="13: clearForcePasswordChangeFlag(userId)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="680" y="630" as="sourcePoint" />
            <mxPoint x="940" y="630" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- M14: Flag cleared -->
        <mxCell id="m14" value="14: flagCleared" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="940" y="660" as="sourcePoint" />
            <mxPoint x="680" y="660" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- M15: Redirect to dashboard -->
        <mxCell id="m15" value="15: redirectToDashboard()" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="680" y="690" as="sourcePoint" />
            <mxPoint x="430" y="690" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- M16: Display dashboard -->
        <mxCell id="m16" value="16: displayDashboard()" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="430" y="720" as="sourcePoint" />
            <mxPoint x="165" y="720" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Alt: Error cases -->
        <mxCell id="alt-errors" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=30;height=20;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=5;fontSize=11;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="60" y="740" width="990" height="40" as="geometry" />
        </mxCell>
        <mxCell id="alt-err-label" value="[Password same as temporary / Password does not meet strength rules] — Display specific error, return to step 6" style="text;html=1;fontSize=10;fontStyle=2;align=left;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="100" y="745" width="800" height="30" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
