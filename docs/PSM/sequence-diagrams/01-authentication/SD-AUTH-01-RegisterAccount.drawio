<mxfile host="Electron" agent="HomeLodge-Doc">
  <diagram id="sd-auth-01" name="SD-AUTH-01 Register Account">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="SD-AUTH-01: Register Account (Email / Password)" style="text;html=1;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="500" height="30" as="geometry" />
        </mxCell>

        <!-- Lifeline: Guest -->
        <mxCell id="ll-guest" value="Guest" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="70" width="120" height="700" as="geometry" />
        </mxCell>

        <!-- Lifeline: Registration Page -->
        <mxCell id="ll-regpage" value="Registration Page" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="70" width="140" height="700" as="geometry" />
        </mxCell>

        <!-- Lifeline: System -->
        <mxCell id="ll-system" value="System" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="70" width="120" height="700" as="geometry" />
        </mxCell>

        <!-- Lifeline: Database -->
        <mxCell id="ll-db" value="Database" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="920" y="70" width="120" height="700" as="geometry" />
        </mxCell>

        <!-- Message 1: Guest opens registration page -->
        <mxCell id="msg1" value="1: openRegistrationPage()" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="180" y="140" as="sourcePoint" />
            <mxPoint x="450" y="140" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Message 2: Display registration form -->
        <mxCell id="msg2" value="2: displayRegistrationForm()" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="450" y="170" as="sourcePoint" />
            <mxPoint x="180" y="170" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Message 3: Enter details -->
        <mxCell id="msg3" value="3: enterDetails(fullName, email, password, confirmPassword)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="180" y="210" as="sourcePoint" />
            <mxPoint x="450" y="210" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Message 4: Submit registration -->
        <mxCell id="msg4" value="4: submitRegistration(fullName, email, password, confirmPassword)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="450" y="250" as="sourcePoint" />
            <mxPoint x="710" y="250" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Message 5: Validate inputs -->
        <mxCell id="msg5" value="5: validateEmailFormat(email)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="720" y="290" as="sourcePoint" />
            <mxPoint x="720" y="310" as="targetPoint" />
            <Array as="points">
              <mxPoint x="770" y="290" />
              <mxPoint x="770" y="310" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Message 6: Check email uniqueness -->
        <mxCell id="msg6" value="6: checkEmailExists(email)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="710" y="330" as="sourcePoint" />
            <mxPoint x="980" y="330" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Message 7: Return email check result -->
        <mxCell id="msg7" value="7: emailNotFound" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="980" y="360" as="sourcePoint" />
            <mxPoint x="710" y="360" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Message 8: Validate password strength -->
        <mxCell id="msg8" value="8: validatePasswordStrength(password)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="720" y="390" as="sourcePoint" />
            <mxPoint x="720" y="410" as="targetPoint" />
            <Array as="points">
              <mxPoint x="770" y="390" />
              <mxPoint x="770" y="410" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Message 9: Hash and save password -->
        <mxCell id="msg9" value="9: hashAndSavePassword(password)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="720" y="440" as="sourcePoint" />
            <mxPoint x="720" y="460" as="targetPoint" />
            <Array as="points">
              <mxPoint x="770" y="440" />
              <mxPoint x="770" y="460" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Message 10: Create account -->
        <mxCell id="msg10" value="10: createAccount(fullName, email, hashedPassword)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="710" y="480" as="sourcePoint" />
            <mxPoint x="980" y="480" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Message 11: Account created confirmation -->
        <mxCell id="msg11" value="11: accountCreated" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="980" y="510" as="sourcePoint" />
            <mxPoint x="710" y="510" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Message 12: Assign Guest role -->
        <mxCell id="msg12" value="12: assignRole(&quot;Guest&quot;)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="710" y="540" as="sourcePoint" />
            <mxPoint x="980" y="540" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Message 13: Role assigned -->
        <mxCell id="msg13" value="13: roleAssigned" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="980" y="570" as="sourcePoint" />
            <mxPoint x="710" y="570" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Message 14: Return success -->
        <mxCell id="msg14" value="14: registrationSuccess()" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="710" y="600" as="sourcePoint" />
            <mxPoint x="450" y="600" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Message 15: Display success and redirect -->
        <mxCell id="msg15" value="15: displaySuccessMessage()&#xa;redirect to Sign-In Page" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="450" y="640" as="sourcePoint" />
            <mxPoint x="180" y="640" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Alt fragment for validation errors -->
        <mxCell id="alt1" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=30;height=20;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=5;fontSize=11;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="130" y="680" width="920" height="70" as="geometry" />
        </mxCell>
        <mxCell id="alt1-label" value="[email already in use / invalid format / password mismatch / weak password] — Display specific error, return to step 3" style="text;html=1;fontSize=10;fontStyle=2;align=left;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="170" y="700" width="850" height="30" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
