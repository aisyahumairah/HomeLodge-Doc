<mxfile host="Electron" agent="HomeLodge-Doc">
  <diagram id="sd-auth-03" name="SD-AUTH-03 Logout">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="SD-AUTH-03: Logout" style="text;html=1;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="300" height="30" as="geometry" />
        </mxCell>

        <!-- ============================================ -->
        <!-- Lifelines                                     -->
        <!-- ============================================ -->
        <mxCell id="ll-user" value="Registered User&#xa;(Guest or Admin)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=45;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="70" width="130" height="470" as="geometry" />
        </mxCell>

        <mxCell id="ll-navmenu" value="Navigation Menu" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="70" width="140" height="470" as="geometry" />
        </mxCell>

        <mxCell id="ll-system" value="System" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="70" width="120" height="470" as="geometry" />
        </mxCell>

        <mxCell id="ll-db" value="Database" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="870" y="70" width="120" height="470" as="geometry" />
        </mxCell>

        <!-- M1: Click Logout -->
        <mxCell id="m1" value="1: clickLogout()" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="165" y="150" as="sourcePoint" />
            <mxPoint x="430" y="150" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- M2: Send logout request -->
        <mxCell id="m2" value="2: requestLogout(sessionId)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="430" y="190" as="sourcePoint" />
            <mxPoint x="680" y="190" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- M3: End session -->
        <mxCell id="m3" value="3: endSession(sessionId)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="680" y="230" as="sourcePoint" />
            <mxPoint x="930" y="230" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- M4: Session ended -->
        <mxCell id="m4" value="4: sessionEnded" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="930" y="260" as="sourcePoint" />
            <mxPoint x="680" y="260" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- M5: Clear remember me -->
        <mxCell id="m5" value="5: clearRememberMeToken()" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="690" y="290" as="sourcePoint" />
            <mxPoint x="690" y="310" as="targetPoint" />
            <Array as="points">
              <mxPoint x="740" y="290" />
              <mxPoint x="740" y="310" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- M6: Invalidate session cookie -->
        <mxCell id="m6" value="6: invalidateSessionCookie()" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="690" y="330" as="sourcePoint" />
            <mxPoint x="690" y="350" as="targetPoint" />
            <Array as="points">
              <mxPoint x="740" y="330" />
              <mxPoint x="740" y="350" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- M7: Redirect to sign-in -->
        <mxCell id="m7" value="7: redirectToSignInPage()" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="680" y="380" as="sourcePoint" />
            <mxPoint x="430" y="380" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- M8: Display sign-in page -->
        <mxCell id="m8" value="8: displaySignInPage()" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="430" y="410" as="sourcePoint" />
            <mxPoint x="165" y="410" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Opt: Back button protection -->
        <mxCell id="opt-back" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=30;height=20;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=5;fontSize=11;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="90" y="440" width="870" height="60" as="geometry" />
        </mxCell>
        <mxCell id="opt-back-label" value="[User presses browser Back button] — System shows Sign-In page instead of protected content (cache invalidation)" style="text;html=1;fontSize=10;fontStyle=2;align=left;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="130" y="460" width="750" height="20" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
