<mxfile host="Electron" agent="HomeLodge-Doc">
  <diagram id="sd-notif-02" name="SD-NOTIF-02 Google Calendar Integration">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="SD-NOTIF-02: Google Calendar Integration" style="text;html=1;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="450" height="30" as="geometry" />
        </mxCell>

        <mxCell id="ll-system" value="System" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="70" width="120" height="520" as="geometry" />
        </mxCell>

        <mxCell id="ll-db" value="Database" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="370" y="70" width="120" height="520" as="geometry" />
        </mxCell>

        <mxCell id="ll-gcal" value="Google Calendar&#xa;API" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=45;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="70" width="140" height="520" as="geometry" />
        </mxCell>

        <mxCell id="ll-user" value="User&#xa;(Guest / Admin)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=45;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="930" y="70" width="130" height="520" as="geometry" />
        </mxCell>

        <mxCell id="m1" value="1: bookingConfirmed(bookingId)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="170" y="150" as="sourcePoint" />
            <mxPoint x="170" y="170" as="targetPoint" />
            <Array as="points">
              <mxPoint x="220" y="150" />
              <mxPoint x="220" y="170" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="m2" value="2: getUserGoogleConnection(userId)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="160" y="190" as="sourcePoint" />
            <mxPoint x="430" y="190" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="m3" value="3: googleConnectionData(accessToken)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="430" y="220" as="sourcePoint" />
            <mxPoint x="160" y="220" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Alt: connected vs not -->
        <mxCell id="alt-conn" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=30;height=20;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=5;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="80" y="250" width="1020" height="210" as="geometry" />
        </mxCell>
        <mxCell id="alt-conn-label1" value="[Google account connected]" style="text;html=1;fontSize=10;fontStyle=3;align=left;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="120" y="270" width="200" height="20" as="geometry" />
        </mxCell>

        <mxCell id="m4" value="4: createOrUpdateCalendarEvent(&#xa;   title=unitName+&quot;Stay&quot;, start=checkIn, end=checkOut,&#xa;   description=bookingRef+address)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="160" y="310" as="sourcePoint" />
            <mxPoint x="710" y="310" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="m5" value="5: eventCreated / eventUpdated" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="710" y="350" as="sourcePoint" />
            <mxPoint x="160" y="350" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="m6" value="6: Event appears in user's Google Calendar" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="710" y="380" as="sourcePoint" />
            <mxPoint x="995" y="380" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Separator -->
        <mxCell id="sep1" value="" style="endArrow=none;dashed=1;html=1;dashPattern=8 8;strokeWidth=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="80" y="420" as="sourcePoint" />
            <mxPoint x="1100" y="420" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="alt-conn-label2" value="[Google account NOT connected] — Skip calendar step. No error shown." style="text;html=1;fontSize=10;fontStyle=3;align=left;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="120" y="430" width="500" height="20" as="geometry" />
        </mxCell>

        <mxCell id="alt-err" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=30;height=20;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=5;fontSize=11;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="60" y="500" width="1060" height="50" as="geometry" />
        </mxCell>
        <mxCell id="alt-err-label" value="[Google Calendar service error / connection expired] — Record failure; user may need to reconnect" style="text;html=1;fontSize=10;fontStyle=2;align=left;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="100" y="520" width="700" height="20" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
