        <mxCell id="m1" value="1: clickRegenerateQR(bookingId)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="150" as="sourcePoint" /><mxPoint x="395" y="150" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m2" value="2: requestRegeneration(bookingId)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="395" y="180" as="sourcePoint" /><mxPoint x="650" y="180" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m3" value="3: invalidateOldQR(bookingId)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="210" as="sourcePoint" /><mxPoint x="910" y="210" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m4" value="4: generateNewQR(bookingId) → same flow as SD-QR-01" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660" y="250" as="sourcePoint" /><mxPoint x="660" y="270" as="targetPoint" /><Array as="points"><mxPoint x="710" y="250" /><mxPoint x="710" y="270" /></Array></mxGeometry></mxCell>
        <mxCell id="m5" value="5: saveNewQR(), notifyGuest(newQR), auditLog(&quot;QR Regenerated&quot;)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="300" as="sourcePoint" /><mxPoint x="910" y="300" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m6" value="6: displayNewQRCode()" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="340" as="sourcePoint" /><mxPoint x="140" y="340" as="targetPoint" /></mxGeometry></mxCell>
