<mxfile host="Electron" agent="HomeLodge-Doc">
  <diagram id="sd-qr-01" name="SD-QR-01 Generate QR Code">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="title" value="SD-QR-01: Generate QR Code" style="text;html=1;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="20" width="400" height="30" as="geometry" /></mxCell>
        <mxCell id="ll-system" value="System&#xa;(Triggered by&#xa;Payment Confirmation)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=55;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="70" width="160" height="480" as="geometry" /></mxCell>
        <mxCell id="ll-db" value="Database" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="70" width="120" height="480" as="geometry" /></mxCell>
        <mxCell id="ll-storage" value="File Storage" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="70" width="120" height="480" as="geometry" /></mxCell>
        <mxCell id="ll-notif" value="Notification&#xa;Service" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=45;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="920" y="70" width="120" height="480" as="geometry" /></mxCell>

        <mxCell id="m1" value="1: generateUniqueCode(bookingId, checkIn, checkOut)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="160" as="sourcePoint" /><mxPoint x="170" y="180" as="targetPoint" /><Array as="points"><mxPoint x="220" y="160" /><mxPoint x="220" y="180" /></Array></mxGeometry></mxCell>
        <mxCell id="m2" value="2: setQRExpiry(checkOutDate + systemExpiryHours)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="200" as="sourcePoint" /><mxPoint x="170" y="220" as="targetPoint" /><Array as="points"><mxPoint x="220" y="200" /><mxPoint x="220" y="220" /></Array></mxGeometry></mxCell>
        <mxCell id="m3" value="3: generateQRImage(encodedData)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="240" as="sourcePoint" /><mxPoint x="720" y="240" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m4" value="4: qrImageUrl" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="270" as="sourcePoint" /><mxPoint x="160" y="270" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m5" value="5: saveQRRecord(bookingId, code, imageUrl, expiry)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="300" as="sourcePoint" /><mxPoint x="460" y="300" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m6" value="6: qrSaved" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="330" as="sourcePoint" /><mxPoint x="160" y="330" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m7" value="7: sendQRToGuest(guestId, qrImage, bookingDetails)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="360" as="sourcePoint" /><mxPoint x="980" y="360" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m8" value="8: QR also visible in guest's booking detail page" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="980" y="390" as="sourcePoint" /><mxPoint x="160" y="390" as="targetPoint" /></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
