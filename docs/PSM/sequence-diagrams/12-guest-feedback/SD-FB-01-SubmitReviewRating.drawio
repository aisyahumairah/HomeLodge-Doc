<mxfile host="Electron" agent="HomeLodge-Doc">
  <diagram id="sd-fb-01" name="SD-FB-01 Submit Review Rating">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="title" value="SD-FB-01: Submit Review &amp; Rating" style="text;html=1;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="20" width="400" height="30" as="geometry" /></mxCell>

        <mxCell id="ll-guest" value="Guest" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="120" height="700" as="geometry" /></mxCell>
        <mxCell id="ll-reviewpage" value="Review Page" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="130" height="700" as="geometry" /></mxCell>
        <mxCell id="ll-system" value="System" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="70" width="120" height="700" as="geometry" /></mxCell>
        <mxCell id="ll-db" value="Database" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="70" width="120" height="700" as="geometry" /></mxCell>
        <mxCell id="ll-notif" value="Notification&#xa;Service" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=45;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1060" y="70" width="120" height="700" as="geometry" /></mxCell>

        <!-- Precondition note -->
        <mxCell id="note-pre" value="Precondition: Guest has a completed&#xa;booking (checked-out status) and&#xa;has NOT yet submitted a review for it." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=18;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=5;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="220" height="60" as="geometry" /></mxCell>

        <mxCell id="m1" value="1: navigateToCompletedBooking() → clickLeaveReview()" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="210" as="sourcePoint" /><mxPoint x="365" y="210" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m2" value="2: displayReviewForm(unitName, bookingDates)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365" y="240" as="sourcePoint" /><mxPoint x="120" y="240" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m3" value="3: selectRating(1-5 stars)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="280" as="sourcePoint" /><mxPoint x="365" y="280" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m4" value="4: writeReviewComment(text)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="310" as="sourcePoint" /><mxPoint x="365" y="310" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m5" value="5: clickSubmitReview()" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="340" as="sourcePoint" /><mxPoint x="365" y="340" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m6" value="6: submitReview(bookingId, guestId, unitId, rating, comment)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365" y="370" as="sourcePoint" /><mxPoint x="620" y="370" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m7" value="7: validateReview(ratingRequired, duplicateCheck)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="630" y="400" as="sourcePoint" /><mxPoint x="630" y="420" as="targetPoint" /><Array as="points"><mxPoint x="680" y="400" /><mxPoint x="680" y="420" /></Array></mxGeometry></mxCell>
        <mxCell id="m8" value="8: saveReview(rating, comment, timestamp)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="440" as="sourcePoint" /><mxPoint x="880" y="440" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m9" value="9: recalculateUnitAvgRating(unitId)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="470" as="sourcePoint" /><mxPoint x="880" y="470" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m10" value="10: avgRatingUpdated" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="500" as="sourcePoint" /><mxPoint x="620" y="500" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m11" value="11: notifyAdmin(&quot;New Review Received&quot;, unitName, rating)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="530" as="sourcePoint" /><mxPoint x="1120" y="530" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m12" value="12: displayThankYouMessage()" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="570" as="sourcePoint" /><mxPoint x="120" y="570" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="alt1" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=30;height=20;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=5;fontSize=11;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="1180" height="50" as="geometry" /></mxCell>
        <mxCell id="alt1-label" value="[No rating selected / Already reviewed this booking] — Show validation error" style="text;html=1;fontSize=10;fontStyle=2;align=left;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="80" y="630" width="700" height="20" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
