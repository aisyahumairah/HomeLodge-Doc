        <mxCell id="ll-admin" value="Admin" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="70" width="120" height="500" as="geometry" /></mxCell>
        <mxCell id="ll-feedbackpage" value="Feedback&#xa;Management Page" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=45;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="70" width="150" height="500" as="geometry" /></mxCell>
        <mxCell id="ll-system" value="System" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="70" width="120" height="500" as="geometry" /></mxCell>
        <mxCell id="ll-db" value="Database" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="850" y="70" width="120" height="500" as="geometry" /></mxCell>

        <mxCell id="m1" value="1: selectReview(reviewId) → clickReply()" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="150" as="sourcePoint" /><mxPoint x="395" y="150" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m2" value="2: displayReplyTextBox()" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="395" y="180" as="sourcePoint" /><mxPoint x="140" y="180" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m3" value="3: typeReply(replyText)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="220" as="sourcePoint" /><mxPoint x="395" y="220" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m4" value="4: clickSubmitReply()" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="250" as="sourcePoint" /><mxPoint x="650" y="250" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m5" value="5: saveReply(reviewId, adminId, replyText, timestamp)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="280" as="sourcePoint" /><mxPoint x="910" y="280" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m6" value="6: replySaved" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="310" as="sourcePoint" /><mxPoint x="650" y="310" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m7" value="7: Reply now visible on unit detail page&#xa;   under the guest's review" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="350" as="sourcePoint" /><mxPoint x="140" y="350" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="note1" value="Note: Only one reply per review allowed.&#xa;Admin can edit the reply later if needed." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=18;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=5;" vertex="1" parent="1"><mxGeometry x="570" y="400" width="280" height="50" as="geometry" /></mxCell>
