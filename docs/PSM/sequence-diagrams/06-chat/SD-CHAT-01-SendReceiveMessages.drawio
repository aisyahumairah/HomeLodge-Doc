<mxfile host="Electron" agent="HomeLodge-Doc">
  <diagram id="sd-chat-01" name="SD-CHAT-01 Send Receive Messages">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="SD-CHAT-01: Send / Receive Messages" style="text;html=1;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="450" height="30" as="geometry" />
        </mxCell>

        <mxCell id="ll-sender" value="Sender&#xa;(Guest / Admin)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=45;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="70" width="130" height="520" as="geometry" />
        </mxCell>
        <mxCell id="ll-chatpage" value="Chat Page" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="70" width="120" height="520" as="geometry" />
        </mxCell>
        <mxCell id="ll-system" value="System" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="590" y="70" width="120" height="520" as="geometry" />
        </mxCell>
        <mxCell id="ll-db" value="Database" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="840" y="70" width="120" height="520" as="geometry" />
        </mxCell>
        <mxCell id="ll-recipient" value="Recipient&#xa;(Guest / Admin)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=45;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="70" width="130" height="520" as="geometry" />
        </mxCell>

        <mxCell id="m1" value="1: openChatPage()" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="145" y="150" as="sourcePoint" /><mxPoint x="400" y="150" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m2" value="2: typeMessage(messageContent)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="145" y="190" as="sourcePoint" /><mxPoint x="400" y="190" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m3" value="3: clickSend() / pressEnter()" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="145" y="220" as="sourcePoint" /><mxPoint x="400" y="220" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m4" value="4: sendMessage(senderId, recipientId, content, timestamp)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="400" y="250" as="sourcePoint" /><mxPoint x="650" y="250" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m5" value="5: saveMessage(senderId, recipientId, content, timestamp)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="650" y="280" as="sourcePoint" /><mxPoint x="900" y="280" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m6" value="6: messageSaved" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="900" y="310" as="sourcePoint" /><mxPoint x="650" y="310" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m7" value="7: displayMessage(&quot;sent&quot;) in sender's chat window" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="650" y="340" as="sourcePoint" /><mxPoint x="145" y="340" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="opt-online" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=30;height=20;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=5;fontSize=11;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="570" y="370" width="640" height="60" as="geometry" />
        </mxCell>
        <mxCell id="opt-online-label" value="[Recipient is online]" style="text;html=1;fontSize=10;fontStyle=3;align=left;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="610" y="390" width="150" height="20" as="geometry" />
        </mxCell>
        <mxCell id="m8" value="8: deliverMessageInstantly(content)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="650" y="410" as="sourcePoint" /><mxPoint x="1145" y="410" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="alt1" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=30;height=20;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=5;fontSize=11;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="60" y="460" width="1190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="alt1-label" value="[Empty message] — Send button disabled. [Connection lost] — Show &quot;Reconnecting...&quot;; message saved on reload." style="text;html=1;fontSize=10;fontStyle=2;align=left;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="100" y="480" width="800" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
