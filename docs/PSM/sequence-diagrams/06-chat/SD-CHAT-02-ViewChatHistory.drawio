<mxfile host="Electron" agent="HomeLodge-Doc">
  <diagram id="sd-chat-02" name="SD-CHAT-02 View Chat History">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="SD-CHAT-02: View Chat History" style="text;html=1;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ll-user" value="User&#xa;(Guest / Admin)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=45;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="70" width="120" height="420" as="geometry" />
        </mxCell>
        <mxCell id="ll-chatpage" value="Chat Page" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="70" width="120" height="420" as="geometry" />
        </mxCell>
        <mxCell id="ll-system" value="System" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="610" y="70" width="120" height="420" as="geometry" />
        </mxCell>
        <mxCell id="ll-db" value="Database" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="860" y="70" width="120" height="420" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="1: openChatPage()" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="160" y="150" as="sourcePoint" /><mxPoint x="420" y="150" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m2" value="2: getChatHistory(conversationId)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="420" y="180" as="sourcePoint" /><mxPoint x="670" y="180" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m3" value="3: queryMessages(conversationId, orderBy=oldest)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="670" y="210" as="sourcePoint" /><mxPoint x="920" y="210" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m4" value="4: allMessages(sender, content, timestamp)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="920" y="240" as="sourcePoint" /><mxPoint x="670" y="240" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m5" value="5: markUnreadAsRead(userId, conversationId)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="670" y="270" as="sourcePoint" /><mxPoint x="920" y="270" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m6" value="6: displayChatHistory(own messages right,&#xa;   received messages left, auto-scroll to newest)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="670" y="310" as="sourcePoint" /><mxPoint x="160" y="310" as="targetPoint" /></mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
