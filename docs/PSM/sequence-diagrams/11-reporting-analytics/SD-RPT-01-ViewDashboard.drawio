<mxfile host="Electron" agent="HomeLodge-Doc">
  <diagram id="sd-rpt-01" name="SD-RPT-01 View Dashboard">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="title" value="SD-RPT-01: View Dashboard" style="text;html=1;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="20" width="400" height="30" as="geometry" /></mxCell>

        <mxCell id="ll-admin" value="Admin" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="70" width="120" height="560" as="geometry" /></mxCell>
        <mxCell id="ll-dashboard" value="Dashboard Page" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="70" width="140" height="560" as="geometry" /></mxCell>
        <mxCell id="ll-system" value="System" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="70" width="120" height="560" as="geometry" /></mxCell>
        <mxCell id="ll-db" value="Database" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="850" y="70" width="120" height="560" as="geometry" /></mxCell>

        <mxCell id="m1" value="1: navigateToDashboard()" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="140" as="sourcePoint" /><mxPoint x="400" y="140" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m2" value="2: getDashboardMetrics()" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="170" as="sourcePoint" /><mxPoint x="650" y="170" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="m3" value="3: queryTotalBookings()" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="200" as="sourcePoint" /><mxPoint x="910" y="200" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m4" value="4: queryTotalRevenue()" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="230" as="sourcePoint" /><mxPoint x="910" y="230" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m5" value="5: queryOccupancyRate()" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="260" as="sourcePoint" /><mxPoint x="910" y="260" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m6" value="6: queryUpcomingCheckIns()" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="290" as="sourcePoint" /><mxPoint x="910" y="290" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m7" value="7: queryAvgRating()" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="320" as="sourcePoint" /><mxPoint x="910" y="320" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="m8" value="8: aggregatedMetrics" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="350" as="sourcePoint" /><mxPoint x="650" y="350" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="m9" value="9: buildDashboardWidgets(KPI cards, charts,&#xa;   recent activity feed, quick-action shortcuts)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660" y="380" as="sourcePoint" /><mxPoint x="660" y="400" as="targetPoint" /><Array as="points"><mxPoint x="710" y="380" /><mxPoint x="710" y="400" /></Array></mxGeometry></mxCell>

        <mxCell id="m10" value="10: displayDashboard(totalBookings, revenue,&#xa;   occupancyRate, upcomingCheckIns, avgRating,&#xa;   revenueChart, bookingTrendChart)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="440" as="sourcePoint" /><mxPoint x="140" y="440" as="targetPoint" /></mxGeometry></mxCell>

        <!-- Opt: Date range filter -->
        <mxCell id="opt-filter" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=30;height=20;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=5;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="90" y="490" width="870" height="60" as="geometry" /></mxCell>
        <mxCell id="opt-filter-label" value="[Admin selects date range filter] — Re-query metrics for selected period and refresh widgets" style="text;html=1;fontSize=10;fontStyle=3;align=left;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="130" y="510" width="600" height="20" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
