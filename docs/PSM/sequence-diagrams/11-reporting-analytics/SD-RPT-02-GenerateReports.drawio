<mxfile host="Electron" agent="HomeLodge-Doc">
  <diagram id="sd-rpt-02" name="SD-RPT-02 Generate Reports">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="title" value="SD-RPT-02: Generate Reports" style="text;html=1;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="20" width="400" height="30" as="geometry" /></mxCell>

        <mxCell id="ll-admin" value="Admin" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="70" width="120" height="550" as="geometry" /></mxCell>
        <mxCell id="ll-reportspage" value="Reports Page" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="70" width="130" height="550" as="geometry" /></mxCell>
        <mxCell id="ll-system" value="System" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="70" width="120" height="550" as="geometry" /></mxCell>
        <mxCell id="ll-db" value="Database" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="850" y="70" width="120" height="550" as="geometry" /></mxCell>

        <mxCell id="m1" value="1: navigateToReports()" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="140" as="sourcePoint" /><mxPoint x="395" y="140" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m2" value="2: displayReportTypeSelector(Booking, Revenue,&#xa;   Occupancy, Feedback, Payment)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="395" y="180" as="sourcePoint" /><mxPoint x="140" y="180" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m3" value="3: selectReportType(type), selectDateRange(start, end),&#xa;   selectFilters(unit, status)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="230" as="sourcePoint" /><mxPoint x="395" y="230" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m4" value="4: clickGenerateReport()" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="270" as="sourcePoint" /><mxPoint x="650" y="270" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m5" value="5: queryReportData(type, dateRange, filters)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="300" as="sourcePoint" /><mxPoint x="910" y="300" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m6" value="6: reportData" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="330" as="sourcePoint" /><mxPoint x="650" y="330" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m7" value="7: buildReportVisualisations(tables, charts, summaries)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660" y="360" as="sourcePoint" /><mxPoint x="660" y="380" as="targetPoint" /><Array as="points"><mxPoint x="710" y="360" /><mxPoint x="710" y="380" /></Array></mxGeometry></mxCell>
        <mxCell id="m8" value="8: displayReport(charts, tables, totals)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="410" as="sourcePoint" /><mxPoint x="140" y="410" as="targetPoint" /></mxGeometry></mxCell>

        <!-- Opt: Export -->
        <mxCell id="opt-export" value="opt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=30;height=20;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=5;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="90" y="450" width="870" height="60" as="geometry" /></mxCell>
        <mxCell id="opt-export-label" value="[Admin clicks Export] — Generate downloadable PDF or CSV file" style="text;html=1;fontSize=10;fontStyle=3;align=left;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="130" y="470" width="500" height="20" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
