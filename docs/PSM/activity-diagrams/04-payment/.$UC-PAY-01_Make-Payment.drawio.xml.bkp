        </mxCell>
        <!-- Guest lane -->
        <mxCell id="start" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="lane_user">
          <mxGeometry x="175" y="15" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="a1" value="Guest clicks Pay Now from booking detail or bill view" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="lane_user">
          <mxGeometry x="105" y="80" width="170" height="55" as="geometry"/>
        </mxCell>
        <!-- System lane - main flow -->
        <mxCell id="a2" value="Create payment request with gateway (ToyyibPay / Stripe)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="lane_sys">
          <mxGeometry x="20" y="80" width="180" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="a3" value="Redirect guest to payment gateway page" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="lane_sys">
          <mxGeometry x="20" y="165" width="180" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="d1" value="Guest completes payment?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="lane_sys">
          <mxGeometry x="15" y="245" width="190" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="a4" value="Gateway processes payment and sends webhook callback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="lane_sys">
          <mxGeometry x="20" y="345" width="180" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="a5" value="System validates webhook signature and payload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="lane_sys">
          <mxGeometry x="20" y="430" width="180" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="d2" value="Payment successful?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="lane_sys">
          <mxGeometry x="15" y="510" width="190" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="a6" value="Update payment record: status=paid. Set booking status=confirmed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="lane_sys">
          <mxGeometry x="20" y="610" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="a7" value="Generate QR code for door access (UC-QR-01)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="lane_sys">
          <mxGeometry x="20" y="700" width="180" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="a8" value="Send payment confirmation notification (in-app and email) with receipt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="lane_sys">
          <mxGeometry x="20" y="780" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="a9" value="Redirect guest to booking confirmation page" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="lane_sys">
