  <diagram id="act-pay-01" name="UC-PAY-01 Make Payment">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
