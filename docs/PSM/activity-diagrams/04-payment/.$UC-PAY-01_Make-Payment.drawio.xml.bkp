        <mxCell id="title" value="UC-PAY-01: Make Payment (Online Gateway)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="10" width="450" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="swim" value="" style="shape=swimlane;startSize=20;swimlaneFillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="760" height="1000" as="geometry"/>
        </mxCell>
        <mxCell id="lane_user" value="Guest" style="swimlane;startSize=25;fillColor=#f5f5f5;fontSize=12;fontStyle=1;" vertex="1" parent="swim">
          <mxGeometry x="0" y="20" width="380" height="980" as="geometry"/>
        </mxCell>
