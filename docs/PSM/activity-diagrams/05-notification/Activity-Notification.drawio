        <mxCell id="a3" value="Create in-app notification record (stored in database, shown in notification bell)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="290" width="200" height="60" as="geometry" /></mxCell>
