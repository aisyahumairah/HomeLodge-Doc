  <diagram id="act-notif-01" name="UC-NOTIF-01 Receive System Notification">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="title" value="UC-NOTIF-01: Receive System Notification" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="10" width="600" height="28" as="geometry" /></mxCell>
        <mxCell id="start" value="" style="ellipse;aspect=fixed;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="567" y="50" width="26" height="26" as="geometry" /></mxCell>
        <mxCell id="a1" value="System event triggers notification (booking confirmed, payment received, cancellation, reminder, etc.)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="100" width="200" height="75" as="geometry" /></mxCell>
