        <mxCell id="title" value="UC-CHAT-01: Send / Receive Messages" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="10" width="600" height="28" as="geometry" /></mxCell>
